<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>HÓA ĐƠN VIỆN PHÍ - <%= payment.invoice_code %></title>
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 14px; color: #1e293b; padding: 30px; margin: 0; background: #fff; }
    .receipt-box { max-width: 680px; margin: 0 auto; border: 1px solid #cbd5e1; padding: 30px; border-radius: 8px; }
    .header-table { width: 100%; border-bottom: 2px solid #0d9488; padding-bottom: 15px; margin-bottom: 20px; }
    .title { text-align: center; margin: 20px 0; font-size: 22px; font-weight: 800; color: #0f172a; text-transform: uppercase; }
    .info-grid { width: 100%; margin-bottom: 20px; }
    .info-grid td { padding: 5px 0; font-size: 13.5px; }
    .items-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    .items-table th, .items-table td { border: 1px solid #cbd5e1; padding: 10px; text-align: left; }
    .items-table th { background: #f8fafc; font-weight: 700; }
    .total-section { text-align: right; margin-top: 15px; font-size: 15px; }
    .signatures { display: flex; justify-content: space-between; margin-top: 40px; text-align: center; }
    @media print {
      body { padding: 0; }
      .receipt-box { border: none; }
      .no-print { display: none; }
    }
  </style>
</head>
<body>
  <div style="text-align: right; max-width: 680px; margin: 0 auto 10px;" class="no-print">
    <button onclick="window.print()" style="padding: 8px 16px; background: #0d9488; color: #fff; border: none; border-radius: 6px; font-weight: 700; cursor: pointer;">
      🖨️ In hóa đơn
    </button>
  </div>

  <div class="receipt-box">
    <table class="header-table">
      <tr>
        <td style="width: 60%;">
          <strong style="font-size: 16px; color: #0d9488;"><%= siteSettings.clinicName %></strong><br>
          <span style="font-size: 12px; color: #64748b;">
            <% if (siteSettings.address) { %>Địa chỉ: <%= siteSettings.address %><br><% } %>
            <% if (siteSettings.hotline) { %>Hotline: <%= siteSettings.hotline %><br><% } %>
            <% if (siteSettings.email) { %>Email: <%= siteSettings.email %><% } %>
          </span>
        </td>
        <td style="text-align: right; font-size: 12px;">
          Số HĐ: <strong><%= payment.invoice_code %></strong><br>
          Mã đặt khám: <strong><%= appointment.booking_code %></strong><br>
          Ngày in: <%= new Date().toLocaleDateString('vi-VN') %>
        </td>
      </tr>
    </table>

    <div class="title">HÓA ĐƠN THU TIỀN VIỆN PHÍ</div>

    <table class="info-grid">
      <tr>
        <td style="width: 50%;">Họ tên bệnh nhân: <strong><%= appointment.patient_name %></strong></td>
        <td>Số điện thoại: <strong><%= appointment.patient_phone %></strong></td>
      </tr>
      <tr>
        <td>Bác sĩ điều trị: <strong><%= appointment.doctor_name %></strong></td>
        <td>Phòng khám: <strong><%= appointment.room_number %> (<%= appointment.specialty_name %>)</strong></td>
      </tr>
      <tr>
        <td>Chẩn đoán: <strong><%= appointment.clinical_diagnosis || 'Khám lâm sàng định kỳ' %></strong></td>
        <td>Hình thức thanh toán: <strong><%= (payment.payment_method || 'CASH').toUpperCase() %></strong></td>
      </tr>
      <tr>
        <td>Loại khám & Chế độ: <strong><%= appointment.visit_type === 'follow_up' ? 'Tái khám' : 'Lần đầu khám' %></strong> &bull; <strong><%= appointment.treatment_type === 'inpatient' ? `Nội trú (${appointment.inpatient_room || ''} - ${appointment.inpatient_bed || ''})` : 'Ngoại trú' %></strong></td>
        <td>Mức ưu tiên: <strong><%= appointment.priority_level === 'emergency' ? '🚨 Cấp cứu' : (appointment.priority_level === 'priority' ? '⭐ Ưu tiên' : 'Tiêu chuẩn') %></strong></td>
      </tr>
    </table>

    <table class="items-table">
      <thead>
        <tr>
          <th>STT</th>
          <th>Nội dung thanh toán</th>
          <th>ĐVT</th>
          <th>SL</th>
          <th>Đơn giá</th>
          <th>Thành tiền</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>1</td>
          <td><strong>Phí khám & Chẩn đoán chuyên khoa</strong> (<%= appointment.specialty_name %>)</td>
          <td>Lượt</td>
          <td>1</td>
          <td><%= formatCurrency(payment.service_fee) %></td>
          <td><%= formatCurrency(payment.service_fee) %></td>
        </tr>

        <% if (prescription && prescription.items) { %>
          <% prescription.items.forEach((med, idx) => { %>
            <tr>
              <td><%= idx + 2 %></td>
              <td><%= med.medicine_name %> (<%= med.dosage %>)</td>
              <td><%= med.unit %></td>
              <td><%= med.quantity %></td>
              <td><%= formatCurrency(med.unit_price) %></td>
              <td><%= formatCurrency(med.amount) %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>

    <div class="total-section">
      <div style="margin-bottom: 6px;">Tổng chi phí dịch vụ: <strong><%= formatCurrency(payment.total_amount) %></strong></div>
      <div style="margin-bottom: 6px;">Miễn giảm / BHYT: <strong><%= formatCurrency(payment.discount) %></strong></div>
      <div style="font-size: 18px; font-weight: 800; color: #0d9488;">
        SỐ TIỀN THỰC THU: <%= formatCurrency(payment.final_amount) %>
      </div>
      <div style="font-size: 12px; color: #64748b; font-style: italic; margin-top: 4px;">
        (Phí dịch vụ và tiền thuốc theo đơn, nếu có)
      </div>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-top:25px; border-top:1px dashed #cbd5e1; padding-top:20px;">
      <div style="display:flex; align-items:center; gap:16px;">
        <% if (payment.payment_status !== 'paid' && siteSettings.bankCode && siteSettings.bankAccount && siteSettings.bankAccountName) { %>
        <% const qrUrl = `https://img.vietqr.io/image/${siteSettings.bankCode}-${siteSettings.bankAccount}-compact2.png?amount=${Math.round(payment.final_amount)}&addInfo=${encodeURIComponent(payment.invoice_code)}&accountName=${encodeURIComponent(siteSettings.bankAccountName)}`; %>
        <img src="<%= qrUrl %>" alt="VietQR Thanh Toán" style="width:110px; height:110px; border-radius:6px; border:1px solid #cbd5e1; padding:2px; background:#fff;">
        <div style="font-size:12px; color:#475569; line-height:1.5;">
          <strong style="color:#0d9488; font-size:13px;">Thông tin chuyển khoản</strong><br>
          Ngân hàng: <strong><%= siteSettings.bankCode %></strong><br>
          STK: <strong><%= siteSettings.bankAccount %></strong><br>
          Chủ TK: <strong><%= siteSettings.bankAccountName %></strong><br>
          Nội dung: <strong><%= payment.invoice_code %></strong>
        </div>
        <% } %>
      </div>

      <div style="text-align:center; min-width:180px;">
        <strong>Thu ngân lập hóa đơn</strong><br>
        <span style="font-size: 12px; color: #64748b;"><%= payment.payment_status === 'paid' ? 'Đã ghi nhận thanh toán' : 'Chưa thanh toán' %></span><br><br>
        <strong style="color:#0f172a;"><%= payment.cashier_name || 'Lễ tân' %></strong>
      </div>
    </div>

    <div style="text-align:center; margin-top:20px; font-size:12px; color:#94a3b8;">
      Cảm ơn Quý khách đã tin tưởng và sử dụng dịch vụ khám chữa bệnh tại MediBook!
    </div>
  </div>
</body>
</html>
