<!-- 1. YOUMED STYLE BLUE HERO BANNER -->
<section class="youmed-hero">
  <div class="container youmed-hero-inner">
    <div class="youmed-hero-content">
      <div class="youmed-hero-tag">
        <span class="live-dot"></span>
        NỀN TẢNG ĐẶT LỊCH KHÁM
      </div>
      <h1 class="youmed-hero-title">
        Ứng dụng đặt khám thông minh
      </h1>
      <p class="youmed-hero-sub">
        Đặt lịch với <strong><%= doctors.length %> bác sĩ</strong> đang nhận khám trên MediBook.
      </p>

      <!-- Large Center Search Bar (YouMed Signature) -->
      <form action="/doctors" method="GET" class="youmed-search-bar">
        <div class="search-input-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" name="search" placeholder="Triệu chứng, tên bác sĩ, chuyên khoa, phòng khám..." autocomplete="off">
        </div>
        <button type="submit" class="youmed-search-btn">
          <span>Tìm kiếm</span>
        </button>
      </form>

      <!-- Quick Fast Search Tags -->
      <div class="youmed-quick-tags">
        <span>Gợi ý:</span>
        <% specialties.slice(0, 4).forEach(sp => { %>
          <a href="/specialties/<%= sp.slug %>"><%= sp.name %></a>
        <% }); %>
      </div>
    </div>

    <!-- Hero Right Illustration -->
    <div class="youmed-hero-graphic">
      <div class="heart-avatar-backdrop">
        <img src="/assets/images/doctor-hero.jpg" alt="Đội ngũ bác sĩ MediBook" class="youmed-hero-photo">
      </div>
    </div>
  </div>
</section>

<!-- 2. QUICK BOOKING FILTER BAR (DIRECT BOOKING) -->
<section class="container youmed-booking-box-wrap" id="quick-search">
  <div class="youmed-filter-card">
    <div class="filter-card-head">
      <div class="filter-card-title">
        <div class="filter-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div>
          <h4>Đặt lịch khám nhanh theo hẹn</h4>
          <p>Chọn thông tin để lấy số thứ tự ưu tiên khám đúng khung giờ</p>
        </div>
      </div>
      <div class="filter-head-badge">
        Đặt lịch theo giờ
      </div>
    </div>

    <form action="/appointments/book" method="GET" class="youmed-filter-grid">
      <div class="form-group">
        <label for="home_specialty">Chuyên khoa khám</label>
        <select name="specialty_id" id="home_specialty" class="form-control form-control-clean">
          <option value="">-- Chọn chuyên khoa --</option>
          <% specialties.forEach(sp => { %>
            <option value="<%= sp.id %>"><%= sp.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="home_doctor">Bác sĩ tiếp nhận</label>
        <select name="doctor_id" id="home_doctor" class="form-control form-control-clean">
          <option value="">-- Bất kỳ bác sĩ nào --</option>
          <% doctors.forEach(doc => { %>
            <option value="<%= doc.id %>"><%= doc.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="home_date">Ngày dự kiến khám</label>
        <input type="date" name="date" id="home_date" class="form-control form-control-clean" value="<%= today %>" min="<%= today %>">
      </div>

      <div>
        <button type="submit" class="btn btn-primary-youmed btn-book-submit">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          Tìm lịch khám
        </button>
      </div>
    </form>
  </div>
</section>

<!-- 3. UPCOMING APPOINTMENT WIDGET (IF ANY) -->
<% if (upcomingAppointment) { %>
<section class="container" style="margin-bottom: 40px;" data-animate="fade-up">
  <div class="section-header-youmed">
    <div>
      <h3 class="title-main">Lịch hẹn khám sắp tới</h3>
      <p class="title-sub">Phiếu khám và khung giờ của bạn đã sẵn sàng</p>
    </div>
    <a href="/my-appointments" class="youmed-view-more">Xem chi tiết tất cả &rarr;</a>
  </div>

  <a href="/appointments/<%= upcomingAppointment.booking_code %>" class="youmed-ticket-card">
    <div class="ticket-left">
      <div class="ticket-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0088ff" stroke-width="2.5">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <div class="ticket-info">
        <h4><%= upcomingAppointment.service_name || ('Khám ' + upcomingAppointment.specialty_name) %></h4>
        <div class="ticket-doc"><%= upcomingAppointment.doctor_name %></div>
        <div class="ticket-meta">
          <span>📅 <%= upcomingAppointment.appointment_date %></span>
          <span>⏰ <%= upcomingAppointment.start_time %> - <%= upcomingAppointment.end_time %></span>
          <span>📍 Phòng: <%= upcomingAppointment.room_number %></span>
        </div>
      </div>
    </div>
    <div class="ticket-right">
      <span class="badge-status-confirmed">ĐÃ XÁC NHẬN</span>
      <div class="ticket-code">Mã: <strong><%= upcomingAppointment.booking_code %></strong></div>
    </div>
  </a>
</section>
<% } %>

<!-- 4. SECTION: ĐẶT LỊCH KHÁM TRỰC TUYẾN / ĐẶT KHÁM BÁC SĨ (YOUMED STYLE CIRCULAR AVATARS) -->
<section class="container youmed-section" data-animate="fade-up">
  <div class="section-header-youmed">
    <div>
      <h2 class="title-main">Đặt khám bác sĩ</h2>
      <p class="title-sub">Phiếu khám kèm số thứ tự và thời gian của bạn được xác nhận.</p>
    </div>
    <a href="/doctors" class="youmed-btn-pill">
      <span>Xem thêm</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </a>
  </div>

  <div class="youmed-doctors-carousel">
    <% doctors.slice(0, 4).forEach((doc, idx) => { %>
      <div class="youmed-doctor-item">
        <div class="doc-avatar-wrap">
          <img src="/assets/images/doctor-<%= doc.id %>.jpg" alt="<%= doc.name %>" class="doc-circle-img" onerror="this.onerror=null;this.src='/assets/images/doctor-1.jpg';">
        </div>
        <h3 class="doc-item-name">
          <a href="/doctors/<%= doc.id %>"><%= doc.name %></a>
        </h3>
        <div class="doc-item-spec">
          <%= doc.specialty_names || 'Chuyên khoa Tổng quát' %>
        </div>
        <div class="doc-item-hosp">
          Bệnh viện Đa khoa MediBook
        </div>

        <div class="doc-item-footer">
          <a href="/appointments/book?doctor_id=<%= doc.id %>" class="btn-doc-book-link">
            <span>Đặt lịch khám</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<!-- 5. Cơ sở khám -->
<section class="container youmed-section" data-animate="fade-up">
  <div class="section-header-youmed">
    <div>
      <h2 class="title-main">Cơ sở khám</h2>
      <p class="title-sub">Thông tin cơ sở và dịch vụ sẽ hiển thị khi được cấu hình và xác minh.</p>
    </div>
  </div>
  <p>Hiện chưa có cơ sở y tế nào được công bố. Bạn có thể <a href="/doctors">đặt lịch với bác sĩ đang nhận khám</a>.</p>
</section>

<!-- 6. SECTION: ĐẶT LỊCH THEO CHUYÊN KHOA (CIRCULAR COLOR ICONS) -->
<section class="container youmed-section" data-animate="fade-up">
  <div class="section-header-youmed">
    <div>
      <h2 class="title-main">Đặt lịch theo Chuyên khoa</h2>
      <p class="title-sub">Danh sách bác sĩ theo chuyên khoa</p>
    </div>
    <a href="/specialties" class="youmed-btn-pill">
      <span>Tất cả</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </a>
  </div>

  <div class="youmed-specialty-circles">
    <% specialties.forEach(sp => { %>
      <a href="/specialties/<%= sp.slug %>" class="specialty-circle-card">
        <div class="spec-circle-icon spec-bg-<%= sp.slug %>">
          <% if (sp.slug === 'tim-mach') { %>
            🫀
          <% } else if (sp.slug === 'nhi-khoa') { %>
            👶
          <% } else if (sp.slug === 'san-phu-khoa') { %>
            🤰
          <% } else if (sp.slug === 'da-lieu') { %>
            🧴
          <% } else if (sp.slug === 'tai-mui-hong') { %>
            👂
          <% } else if (sp.slug === 'co-xuong-khop') { %>
            🦴
          <% } else if (sp.slug === 'tieu-hoa') { %>
            🥗
          <% } else { %>
            🩺
          <% } %>
        </div>
        <div class="spec-circle-name"><%= sp.name %></div>
        <div class="spec-circle-count"><%= sp.doctor_count %> BS</div>
      </a>
    <% }); %>
  </div>
</section>

<!-- 7. SECTION: TIN Y TẾ - CHÍNH THỐNG & MINH BẠCH (YOUMED ARTICLE TABS) -->
<section class="container youmed-section" data-animate="fade-up" id="tin-y-te-section">
  <div class="youmed-articles-header">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 8px;">
      <h2 class="articles-big-title" style="margin: 0;">Tin Y tế</h2>
      <a href="/articles" style="color: var(--primary); font-weight: 700; font-size: 14.5px; text-decoration: none;">
        Xem tất cả bài viết &rarr;
      </a>
    </div>
    <div class="articles-sub-title">Chính thống - Minh bạch - Trung lập (Tham vấn chuyên gia)</div>

    <div class="articles-tabs-bar">
      <button type="button" class="article-tab active" data-cat="all">Tất cả</button>
      <% articleCategories.forEach(cat => { %>
        <button type="button" class="article-tab" data-cat="<%= cat.category %>"><%= cat.category_name %></button>
      <% }); %>
      <div class="article-search-mini">
        <input type="text" id="article_home_search" placeholder="Nhập tên thuốc, bệnh lý...">
      </div>
    </div>
  </div>

  <div class="youmed-news-grid" id="home_articles_grid">
    <% if (typeof articles !== 'undefined' && articles && articles.length > 0) { %>
      <% articles.forEach(art => { %>
        <a href="/articles/<%= art.slug %>" class="news-card" data-cat="<%= art.category %>" 
           data-title="<%= art.title.toLowerCase() %>" data-summary="<%= art.summary.toLowerCase() %>"
           style="text-decoration: none; color: inherit; display: flex; flex-direction: column;">
          <div class="news-badge-brand">MediBook Y tế</div>
          <div class="news-img-box">
            <div class="news-pill-label"><%= art.pill_label %></div>
            <div style="font-size:48px; text-align:center; padding: 20px 0;"><%= art.icon %></div>
          </div>
          <div class="news-content" style="flex: 1; display: flex; flex-direction: column;">
            <h4 class="news-title" style="margin-bottom: 8px; font-size: 15.5px; line-height: 1.45;">
              <%= art.title %>
            </h4>
            <div class="news-meta" style="margin-top: auto; border-top: 1px solid var(--border-light); padding-top: 10px; font-size: 12px; color: #64748b;">
              <span><%= art.author_name %></span> &bull; <span>Cập nhật mới</span>
            </div>
          </div>
        </a>
      <% }); %>
    <% } %>
  </div>

  <div id="no_articles_match" style="display:none; text-align:center; padding: 40px 20px; background: #f8fafc; border-radius: 12px; border: 1.5px dashed var(--border); margin-top: 16px;">
    <div style="font-size: 32px; margin-bottom: 8px;">🔍</div>
    <div style="font-weight: 700; color: #0f172a; margin-bottom: 4px;">Không tìm thấy bài viết y khoa phù hợp</div>
    <p style="font-size: 13.5px; color: #64748b; margin: 0;">Vui lòng thử tìm kiếm với từ khóa khác hoặc chuyển sang danh mục khác.</p>
  </div>

  <div style="text-align: center; margin-top: 30px;">
    <a href="/articles" class="btn btn-secondary" style="padding: 10px 26px; font-weight: 700; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
      📖 Xem toàn bộ kho cẩm nang y tế MediBook &rarr;
    </a>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabs = document.querySelectorAll('.articles-tabs-bar .article-tab');
  const cards = document.querySelectorAll('#home_articles_grid .news-card');
  const searchInput = document.getElementById('article_home_search');
  const noMatchNotice = document.getElementById('no_articles_match');

  let activeCat = 'all';
  let searchQuery = '';

  function filterArticles() {
    let visibleCount = 0;
    cards.forEach(card => {
      const cardCat = card.getAttribute('data-cat');
      const cardTitle = card.getAttribute('data-title') || '';
      const cardSummary = card.getAttribute('data-summary') || '';

      const matchCat = (activeCat === 'all' || cardCat === activeCat);
      const matchSearch = (!searchQuery || cardTitle.includes(searchQuery) || cardSummary.includes(searchQuery));

      if (matchCat && matchSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noMatchNotice) {
      noMatchNotice.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', function(e) {
      e.preventDefault();
      tabs.forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      activeCat = this.getAttribute('data-cat') || 'all';
      filterArticles();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      searchQuery = this.value.trim().toLowerCase();
      filterArticles();
    });
  }
});
</script>

<!-- 8. Đánh giá từ bệnh nhân -->
<section class="container youmed-section" style="padding-bottom: 70px;" data-animate="fade-up">
  <div class="section-header-youmed">
    <div>
      <h2 class="title-main">Đánh giá từ bệnh nhân</h2>
      <p class="title-sub"><%= completedCount %> lượt khám đã hoàn tất.</p>
    </div>
    <% if (ratingSummary.count) { %>
      <div class="youmed-rating-stars">
        <span>★ <%= ratingSummary.average %> / 5</span>
        <span>(<%= ratingSummary.count %> đánh giá)</span>
      </div>
    <% } %>
  </div>
  <div class="youmed-testimonials-grid">
    <% if (reviews.length) { reviews.forEach(review => { %>
      <div class="testi-card">
        <div class="testi-stars"><%= '★'.repeat(review.rating) %></div>
        <p class="testi-text"><%= review.comment %></p>
        <div class="testi-user"><div class="user-name"><%= review.patient_name %></div></div>
      </div>
    <% }); } else { %>
      <p>Chưa có đánh giá nào.</p>
    <% } %>
  </div>
</section>
