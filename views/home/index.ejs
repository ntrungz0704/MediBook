        <div class="spec-circle-count"><%= sp.doctor_count || 1 %> BS</div>
      </a>
    <% }); %>
  </div>
</section>

<!-- 7. SECTION: TIN Y TẾ - CHÍNH THỐNG & MINH BẠCH (YOUMED ARTICLE TABS) -->
