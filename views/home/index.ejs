<!-- 1. YOUMED STYLE BLUE HERO BANNER -->
<section class="youmed-hero">
  <div class="container youmed-hero-inner">
    <div class="youmed-hero-content">
      <div class="youmed-hero-tag">
        <span class="live-dot"></span>
        HỆ THỐNG Y TẾ SỐ ĐẠT CHUẨN
      </div>
      <h1 class="youmed-hero-title">
        Ứng dụng đặt khám thông minh
      </h1>
      <p class="youmed-hero-sub">
        Đặt khám với hơn <strong>1.000 bác sĩ</strong>, <strong>25 bệnh viện</strong>, <strong>100 phòng khám</strong> trên MediBook để có số thứ tự và khung giờ khám trước.
      </p>

      <!-- Large Center Search Bar (YouMed Signature) -->
      <form action="/doctors" method="GET" class="youmed-search-bar">
        <div class="search-input-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" name="search" placeholder="Triệu chứng, tên bác sĩ, chuyên khoa, phòng khám..." autocomplete="off">
        </div>
        <button type="submit" class="youmed-search-btn">
          <span>Tìm kiếm</span>
        </button>
      </form>

      <!-- Quick Fast Search Tags -->
      <div class="youmed-quick-tags">
        <span>Gợi ý:</span>
        <a href="/doctors?search=nhi">Bác sĩ Nhi khoa</a>
        <a href="/doctors?search=tim">Khám Tim mạch</a>
        <a href="/doctors?search=da%20li%E1%BB%85u">Trị mụn Da liễu</a>
        <a href="/specialties/san-phu-khoa">Khám thai định kỳ</a>
      </div>
    </div>

    <!-- Hero Right Illustration -->
    <div class="youmed-hero-graphic">
      <div class="heart-avatar-backdrop">
        <img src="/assets/images/doctor-hero.jpg" alt="Đội ngũ bác sĩ MediBook" class="youmed-hero-photo">
      </div>
    </div>
  </div>
</section>

<!-- 2. QUICK BOOKING FILTER BAR (DIRECT BOOKING) -->
<section class="container youmed-booking-box-wrap" id="quick-search">
  <div class="youmed-filter-card">
    <div class="filter-card-head">
      <div class="filter-card-title">
        <div class="filter-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div>
          <h4>Đặt lịch khám nhanh theo hẹn</h4>
          <p>Chọn thông tin để lấy số thứ tự ưu tiên khám đúng khung giờ</p>
        </div>
      </div>
      <div class="filter-head-badge">
        Ưu tiên không chờ đợi
      </div>
    </div>

    <form action="/appointments/book" method="GET" class="youmed-filter-grid">
      <div class="form-group">
        <label for="home_specialty">Chuyên khoa khám</label>
        <select name="specialty_id" id="home_specialty" class="form-control form-control-clean">
          <option value="">-- Chọn chuyên khoa --</option>
          <% specialties.forEach(sp => { %>
            <option value="<%= sp.id %>"><%= sp.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="home_doctor">Bác sĩ tiếp nhận</label>
        <select name="doctor_id" id="home_doctor" class="form-control form-control-clean">
          <option value="">-- Bất kỳ bác sĩ nào --</option>
          <% doctors.forEach(doc => { %>
            <option value="<%= doc.id %>"><%= doc.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="home_date">Ngày dự kiến khám</label>
        <input type="date" name="date" id="home_date" class="form-control form-control-clean" value="<%= today %>" min="<%= today %>">
      </div>

      <div>
        <button type="submit" class="btn btn-primary-youmed btn-book-submit">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          Tìm lịch khám
        </button>
      </div>
    </form>
  </div>
</section>

<!-- 3. UPCOMING APPOINTMENT WIDGET (IF ANY) -->
<% if (upcomingAppointment) { %>
<section class="container" style="margin-bottom: 40px;" data-animate="fade-up">
  <div class="section-header-youmed">
    <div>
      <h3 class="title-main">Lịch hẹn khám sắp tới</h3>
      <p class="title-sub">Phiếu khám và khung giờ của bạn đã sẵn sàng</p>
    </div>
    <a href="/my-appointments" class="youmed-view-more">Xem chi tiết tất cả &rarr;</a>
  </div>

  <a href="/appointments/<%= upcomingAppointment.booking_code %>" class="youmed-ticket-card">
    <div class="ticket-left">
      <div class="ticket-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0088ff" stroke-width="2.5">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <div class="ticket-info">
        <h4><%= upcomingAppointment.service_name || ('Khám ' + upcomingAppointment.specialty_name) %></h4>
        <div class="ticket-doc"><%= upcomingAppointment.doctor_name %></div>
        <div class="ticket-meta">
          <span>📅 <%= upcomingAppointment.appointment_date %></span>
          <span>⏰ <%= upcomingAppointment.start_time %> - <%= upcomingAppointment.end_time %></span>
          <span>📍 Phòng: <%= upcomingAppointment.room_number %></span>
        </div>
      </div>
    </div>
    <div class="ticket-right">
      <span class="badge-status-confirmed">ĐÃ XÁC NHẬN</span>
      <div class="ticket-code">Mã: <strong><%= upcomingAppointment.booking_code %></strong></div>
    </div>
  </a>
</section>
<% } %>

<!-- 4. SECTION: ĐẶT LỊCH KHÁM TRỰC TUYẾN / ĐẶT KHÁM BÁC SĨ (YOUMED STYLE CIRCULAR AVATARS) -->
<section class="container youmed-section" data-animate="fade-up">
  <div class="section-header-youmed">
    <div>
      <h2 class="title-main">Đặt khám bác sĩ</h2>
      <p class="title-sub">Phiếu khám kèm số thứ tự và thời gian của bạn được xác nhận.</p>
    </div>
    <a href="/doctors" class="youmed-btn-pill">
      <span>Xem thêm</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </a>
  </div>

  <div class="youmed-doctors-carousel">
    <% doctors.slice(0, 4).forEach((doc, idx) => { %>
      <div class="youmed-doctor-item">
        <div class="doc-avatar-wrap">
          <img src="/assets/images/doctor-<%= doc.id %>.jpg" alt="<%= doc.name %>" class="doc-circle-img" onerror="this.onerror=null;this.src='/assets/images/doctor-1.jpg';">
        </div>
        <h3 class="doc-item-name">
          <a href="/doctors/<%= doc.id %>"><%= doc.name %></a>
        </h3>
        <div class="doc-item-spec">
          <%= doc.specialty_names || 'Chuyên khoa Tổng quát' %>
        </div>
        <div class="doc-item-hosp">
          Bệnh viện Đa khoa MediBook
        </div>

        <div class="doc-item-footer">
          <a href="/appointments/book?doctor_id=<%= doc.id %>" class="btn-doc-book-link">
            <span>Đặt lịch khám</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</section>

