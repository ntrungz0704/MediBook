<!-- 6. SECTION: ĐẶT LỊCH THEO CHUYÊN KHOA (CIRCULAR COLOR ICONS) -->
<section class="container youmed-section" data-animate="fade-up">
  <div class="section-header-youmed">
    <div>
      <h2 class="title-main">Đặt lịch theo Chuyên khoa</h2>
      <p class="title-sub">Danh sách bác sĩ, bệnh viện, phòng khám phân chia theo chuyên khoa chuẩn xác</p>
    </div>
    <a href="/specialties" class="youmed-btn-pill">
      <span>Tất cả</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </a>
  </div>

  <div class="youmed-specialty-circles">
    <% specialties.forEach(sp => { %>
      <a href="/specialties/<%= sp.slug %>" class="specialty-circle-card">
        <div class="spec-circle-icon spec-bg-<%= sp.slug %>">
          <% if (sp.slug === 'tim-mach') { %>
            🫀
          <% } else if (sp.slug === 'nhi-khoa') { %>
            👶
          <% } else if (sp.slug === 'san-phu-khoa') { %>
            🤰
          <% } else if (sp.slug === 'da-lieu') { %>
            🧴
          <% } else if (sp.slug === 'tai-mui-hong') { %>
            👂
          <% } else if (sp.slug === 'co-xuong-khop') { %>
            🦴
