<div class="youmed-page-header">
  <div class="container">
    <div class="breadcrumbs-bar">
      <a href="/">Trang chủ</a> <span>&bull;</span> <span>Dành cho Bác sĩ</span>
    </div>
    <h1 class="page-title">Cổng Thông Tin & Đồng Hành Cùng Bác Sĩ</h1>
    <p class="page-subtitle">Giải pháp quản lý lịch trực, gọi số hàng đợi tự động và số hóa hồ sơ bệnh án thông minh</p>
  </div>
</div>

<div class="container" style="padding: 40px 20px 80px;" data-animate="fade-up">

  <!-- Top Hero / Portal Access Card -->
  <div class="card-box interactive-hover" style="padding: 40px; margin-bottom: 40px; border-left: 6px solid var(--primary); background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 100%);">
    <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 36px; align-items: center;">
      <div>
        <span class="badge badge-primary" style="font-size: 13px; padding: 6px 14px; margin-bottom: 14px; display: inline-block;">
          🩺 Cổng Làm Việc Chuyên Môn
        </span>
        <h2 style="font-size: 26px; font-weight: 800; color: #0f172a; line-height: 1.3; margin-bottom: 12px;">
          Dành riêng cho Đội ngũ Bác sĩ MediBook
        </h2>
        <p style="font-size: 15px; color: #475569; line-height: 1.6; margin-bottom: 20px;">
          Bác sĩ có thể đăng nhập vào hệ thống để tiếp nhận danh sách bệnh nhân hàng ngày, gọi số vào phòng khám, nhập chỉ số sinh tồn và kê toa thuốc điện tử liên thông kho dược tức thì.
        </p>
        <div style="display: flex; gap: 14px; flex-wrap: wrap;">
          <a href="/doctor/dashboard" class="btn btn-primary btn-lg" style="height: 48px; font-weight: 700; padding: 0 24px;">
            Vào Bàn làm việc Bác sĩ &rarr;
          </a>
          <a href="/login" class="btn btn-outline btn-lg" style="height: 48px; padding: 0 20px;">
            Đăng nhập tài khoản
          </a>
        </div>
      </div>

      <div style="background: #ffffff; padding: 24px; border-radius: 14px; border: 1px solid var(--border); box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <h4 style="font-size: 16px; font-weight: 700; color: #0f172a; margin-bottom: 14px; display:flex; align-items:center; gap:8px;">
          <span>⚡</span> Lối tắt thao tác nhanh
        </h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 14px; margin: 0; padding: 0;">
          <li>
            <a href="/doctor/queue" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: #f8fafc; border-radius: 8px; color: #334155; text-decoration: none; font-weight: 600;">
              <span>🩺 Mở hàng đợi phòng khám hôm nay</span>
              <span style="color: var(--primary);">&rarr;</span>
            </a>
          </li>
          <li>
            <a href="/doctor/schedule" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: #f8fafc; border-radius: 8px; color: #334155; text-decoration: none; font-weight: 600;">
              <span>📅 Xem lịch trực & Xin nghỉ phép</span>
              <span style="color: var(--primary);">&rarr;</span>
            </a>
          </li>
          <li>
            <a href="/receptionist/live-board" target="_blank" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: #f8fafc; border-radius: 8px; color: #334155; text-decoration: none; font-weight: 600;">
              <span>📺 Mở màn hình TV gọi số sảnh</span>
              <span style="color: var(--primary);">&rarr;</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Feature Grid for Doctors -->
  <div style="margin-bottom: 50px;">
    <h3 style="font-size: 22px; font-weight: 800; color: #0f172a; text-align: center; margin-bottom: 30px;">
      Tiện ích vượt trội dành cho Bác sĩ điều trị
    </h3>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
      <div class="card-box interactive-hover" style="padding: 28px;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: #ccfbf1; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 16px;">
          📊
        </div>
        <h4 style="font-size: 17px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Hàng đợi khám thông minh</h4>
        <p style="font-size: 13.5px; color: #64748b; line-height: 1.6; margin: 0;">
          Tự động đồng bộ số thứ tự từ bàn tiếp tân. Phân luồng ưu tiên khẩn cấp, người cao tuổi, trẻ em và phụ nữ mang thai chuẩn xác.
        </p>
      </div>

      <div class="card-box interactive-hover" style="padding: 28px;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 16px;">
          💊
        </div>
        <h4 style="font-size: 17px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Kê toa thuốc điện tử</h4>
        <p style="font-size: 13.5px; color: #64748b; line-height: 1.6; margin: 0;">
          Tra cứu nhanh từ kho dược, chia cữ sáng - trưa - chiều - tối chuẩn xác. Hệ thống tự động tính thành tiền và lưu vết bệnh án.
        </p>
      </div>

      <div class="card-box interactive-hover" style="padding: 28px;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: #fef3c7; color: #d97706; display: flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 16px;">
          ⭐
        </div>
        <h4 style="font-size: 17px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Uy tín & Đánh giá người bệnh</h4>
        <p style="font-size: 13.5px; color: #64748b; line-height: 1.6; margin: 0;">
          Xem phản hồi, chấm điểm sao minh bạch sau mỗi ca hoàn thành. Nâng cao chất lượng khám chữa bệnh và chăm sóc người bệnh.
        </p>
      </div>
    </div>
  </div>

  <!-- Registration / Join Partner Section -->
  <div class="card-box" style="padding: 36px; background: #f8fafc; border: 1px solid var(--border); text-align: center;">
    <h3 style="font-size: 20px; font-weight: 800; color: #0f172a; margin-bottom: 10px;">
      Bác sĩ mong muốn gia nhập mạng lưới MediBook?
    </h3>
    <p style="max-width: 600px; margin: 0 auto 20px; font-size: 14px; color: #64748b; line-height: 1.6;">
      Chúng tôi luôn chào đón các Bác sĩ chuyên khoa giàu kinh nghiệm hợp tác làm việc. Vui lòng liên hệ ban quản trị để được hỗ trợ cấp tài khoản.
    </p>
    <div style="display: flex; gap: 14px; justify-content: center;">
      <a href="/contact" class="btn btn-primary">Gửi thông tin ứng tuyển</a>
      <a href="/contact" class="btn btn-secondary">Liên hệ hợp tác</a>
    </div>
  </div>

</div>
