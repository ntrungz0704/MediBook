<div class="youmed-page-header">
  <div class="container">
    <div class="breadcrumbs-bar">
      <a href="/">Trang chủ</a> <span>&bull;</span> <a href="/doctors">Bác sĩ</a> <span>&bull;</span> <span><%= doctor.name %></span>
    </div>
    <h1 class="page-title"><%= doctor.name %></h1>
    <p class="page-subtitle"><%= doctor.specialty_names || 'Chuyên khoa Nội' %> &bull; <%= doctor.experience_years %>+ năm kinh nghiệm &bull; Bệnh viện MediBook</p>
  </div>
</div>

<div class="container" style="max-width: 960px; padding: 30px 20px 80px;">
  <!-- Doctor Profile Header Card YouMed Style -->
  <div class="youmed-doc-profile-card" data-animate="fade-up">
    <div class="profile-avatar-wrap">
      <img src="/assets/images/doctor-<%= doctor.id %>.jpg" alt="<%= doctor.name %>" class="profile-doc-img" onerror="this.onerror=null;this.src='/assets/images/doctor-1.jpg';">
    </div>

    <div class="profile-info-main">
      <div style="display:flex; align-items:center; gap: 12px; margin-bottom: 6px;">
        <h2 style="font-size: 24px; font-weight: 800; color: #0f172a; margin: 0;">
          <%= doctor.name %>
        </h2>
        <span class="badge-status-confirmed" style="background:#e0f2fe; color:#0088ff;"><%= doctor.experience_years %>+ năm KN</span>
      </div>

      <div style="font-size: 14.5px; color: var(--text-muted); margin-bottom: 12px;">
        Chuyên khoa: <strong style="color:#0088ff;"><%= doctor.specialty_names || 'Nội tổng quát' %></strong> &bull; Phòng khám: <strong><%= doctor.room_number %></strong>
      </div>

      <div style="display: flex; align-items: center; gap: 20px; font-size: 14px;">
        <div style="color:#f59e0b; font-weight:700;">★ <strong><%= Number(doctor.rating).toFixed(1) %></strong> (<%= doctor.rating_count %> đánh giá)</div>
        <div>Phí khám: <strong style="color:#0088ff; font-size:16px;"><%= formatCurrency(doctor.consultation_fee) %></strong></div>
      </div>
    </div>

    <div class="profile-cta-group">
      <button type="button" class="btn-favorite-youmed" data-doctor-id="<%= doctor.id %>" data-doctor-name="<%= doctor.name %>" title="Lưu bác sĩ" style="width:46px; height:46px; border-radius:12px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
      </button>
      <a href="/appointments/book?doctor_id=<%= doctor.id %>" class="btn btn-primary-youmed" style="padding:12px 24px; font-size:15px;">
        Đặt lịch khám ngay &rarr;
      </a>
    </div>
  </div>

  <!-- Bio & Working Schedule -->
  <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; margin-bottom: 30px;">
    <div class="card-box" style="padding: 24px;">
      <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 12px;">Tiểu sử & Chuyên môn</h3>
      <p style="color: #475569; line-height: 1.7;"><%= doctor.bio || 'Bác sĩ chuyên khoa giàu kinh nghiệm và tận tâm với bệnh nhân.' %></p>
    </div>

    <div class="card-box" style="padding: 24px;">
      <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 14px;">Lịch trực hàng tuần</h3>
      <% if (!schedules || schedules.length === 0) { %>
        <p class="text-muted">Chưa cập nhật lịch trực.</p>
      <% } else { %>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 13.5px;">
          <% 
            const dayNames = ['Chủ nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            schedules.forEach(sc => { 
          %>
            <li style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border-light); padding-bottom:6px;">
              <strong><%= dayNames[sc.day_of_week] || ('Thứ ' + (sc.day_of_week + 1)) %></strong>
              <span><%= sc.start_time %> - <%= sc.end_time %></span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </div>

  <!-- Patient Reviews -->
  <div class="card-box" style="padding: 28px;">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px;">
      Đánh giá từ bệnh nhân (<%= reviews ? reviews.length : 0 %>)
    </h3>

    <% if (!reviews || reviews.length === 0) { %>
      <p class="text-muted">Chưa có đánh giá nào cho bác sĩ.</p>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <% reviews.forEach(rev => { %>
          <div style="border-bottom: 1px solid var(--border-light); padding-bottom: 16px;">
            <div style="display:flex; justify-content:space-between; margin-bottom: 6px;">
              <strong><%= rev.reviewer_name %></strong>
              <span style="color:#eab308;font-size:14px;"><%= '⭐'.repeat(rev.rating) %></span>
            </div>
            <p style="color: #475569; font-size: 14px; margin: 0;"><%= rev.comment %></p>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;"><%= formatDate(rev.created_at) %></div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
