<div class="youmed-page-header">
  <div class="container">
    <div class="breadcrumbs-bar">
      <a href="/">Trang chủ</a> <span>&bull;</span> <span>Đặt khám Bác sĩ</span>
    </div>
    <h1 class="page-title">Đội ngũ Bác sĩ chuyên khoa MediBook</h1>
    <p class="page-subtitle">Tìm bác sĩ chính xác - Đặt lịch khám dễ dàng với hơn 1.000+ chuyên gia y tế giàu kinh nghiệm</p>
  </div>
</div>

<div class="container" style="padding: 30px 20px 80px;" data-animate="fade-up">
  <!-- Filter & Search Toolbar -->
  <div class="youmed-toolbar">
    <div class="toolbar-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.5">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" placeholder="Tìm theo tên bác sĩ..." id="doctor-search-input" onkeyup="filterDoctorList(this.value)">
    </div>

    <!-- Filter by Specialty -->
    <div class="toolbar-filter">
      <label>Chuyên khoa:</label>
      <select onchange="if(this.value){ location.href='/doctors?specialty_id='+this.value; } else { location.href='/doctors'; }" class="form-control form-control-clean" style="min-width:240px; height:42px;">
        <option value="">-- Tất cả chuyên khoa (<%= doctors ? doctors.length : 0 %> BS) --</option>
        <% (specialties || []).forEach(sp => { %>
          <option value="<%= sp.id %>" <%= typeof selectedSpecialtyId !== 'undefined' && selectedSpecialtyId == sp.id ? 'selected' : '' %>>
            <%= sp.name %>
          </option>
        <% }); %>
      </select>
    </div>
  </div>

  <div class="youmed-doctors-list-grid" id="doctors-container">
    <% doctors.forEach(doc => { %>
      <div class="youmed-doc-card interactive-hover doc-item-card" data-name="<%= doc.name.toLowerCase() %>">
        <div class="doc-card-head">
          <div class="doc-card-avatar">
            <img src="/assets/images/doctor-<%= doc.id %>.jpg" alt="<%= doc.name %>" class="doc-round-img" onerror="this.onerror=null;this.src='/assets/images/doctor-1.jpg';">
          </div>
          <button type="button" class="btn-favorite-youmed" data-doctor-id="<%= doc.id %>" data-doctor-name="<%= doc.name %>" title="Lưu bác sĩ">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          </button>
        </div>

        <div class="doc-card-info">
          <h3 class="doc-card-name">
            <a href="/doctors/<%= doc.id %>"><%= doc.name %></a>
          </h3>
          <div class="doc-card-specialty"><%= doc.specialty_names || 'Nội tổng quát' %></div>
          <div class="doc-card-facility">Phòng khám <%= doc.room_number %></div>

          <p class="doc-card-bio">
            <%= doc.bio || 'Bác sĩ chuyên khoa giàu kinh nghiệm, tận tâm, cam kết đồng hành cùng sức khỏe bệnh nhân.' %>
          </p>

          <div class="doc-card-metrics">
            <div class="doc-star-rating">
              <span style="color:#f59e0b;">★</span> <%= Number(doc.rating).toFixed(1) %>
              <span class="rating-count">(<%= doc.rating_count %> đánh giá)</span>
            </div>
            <div class="doc-price">
              <%= doc.consultation_fee ? new Intl.NumberFormat('vi-VN').format(doc.consultation_fee) + ' ₫' : '200.000 ₫' %>
            </div>
          </div>

          <div class="doc-card-actions">
            <a href="/doctors/<%= doc.id %>" class="btn btn-secondary-youmed">Xem hồ sơ</a>
            <a href="/appointments/book?doctor_id=<%= doc.id %>" class="btn btn-primary-youmed">Đặt lịch khám</a>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <script>
    function filterDoctorList(val) {
      const q = val.trim().toLowerCase();
      const cards = document.querySelectorAll('.doc-item-card');
      cards.forEach(card => {
        const name = card.getAttribute('data-name') || '';
        if (name.includes(q)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }
  </script>

  <!-- SECTION BỔ SUNG 1: TIÊU CHUẨN ĐỘI NGŨ BÁC SĨ -->
  <div style="margin-top: 60px; background:#ffffff; border-radius:20px; padding:35px 30px; border:1px solid var(--border);" data-animate="fade-up">
    <div style="text-align:center; max-width:680px; margin:0 auto 30px;">
      <h2 style="font-size:24px; font-weight:800; color:#0f172a; margin-bottom:8px;">Tiêu chuẩn tuyển chọn Bác sĩ tại MediBook</h2>
      <p style="color:#64748b; font-size:14px;">100% y bác sĩ đều có chứng chỉ hành nghề và tuân thủ chuẩn mực y đức khắt khe</p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:24px;">
      <div style="background:#f8fafc; padding:22px; border-radius:14px; border:1px solid #e2e8f0;">
        <div style="font-size:24px; margin-bottom:10px;">🎓</div>
        <h4 style="font-size:16px; font-weight:700; color:#0f172a; margin-bottom:6px;">Trình độ chuyên môn cao</h4>
        <p style="font-size:13px; color:#64748b; line-height:1.5;">Tốt nghiệp các trường Đại học Y Dược hàng đầu, đạt học vị Thạc sĩ, Bác sĩ Chuyên khoa I, II.</p>
      </div>

      <div style="background:#f8fafc; padding:22px; border-radius:14px; border:1px solid #e2e8f0;">
        <div style="font-size:24px; margin-bottom:10px;">⏱️</div>
        <h4 style="font-size:16px; font-weight:700; color:#0f172a; margin-bottom:6px;">Tối thiểu 5+ năm kinh nghiệm</h4>
        <p style="font-size:13px; color:#64748b; line-height:1.5;">Xem hồ sơ từng bác sĩ để chọn chuyên khoa và lịch khám phù hợp.</p>
      </div>

      <div style="background:#f8fafc; padding:22px; border-radius:14px; border:1px solid #e2e8f0;">
        <div style="font-size:24px; margin-bottom:10px;">❤️</div>
        <h4 style="font-size:16px; font-weight:700; color:#0f172a; margin-bottom:6px;">Lương y như từ mẫu</h4>
        <p style="font-size:13px; color:#64748b; line-height:1.5;">Lắng nghe tận tình, giải thích cặn kẽ kết quả bệnh án và tư vấn phác đồ điều trị an toàn, tiết kiệm.</p>
      </div>
    </div>
  </div>

  <!-- SECTION BỔ SUNG 2: CÂU HỎI THƯỜNG GẶP -->
  <div style="margin-top: 40px; background:#f1f5f9; border-radius:20px; padding:35px 30px;" data-animate="fade-up">
    <h3 style="font-size:20px; font-weight:800; color:#0f172a; margin-bottom:18px; text-align:center;">Câu hỏi thường gặp khi chọn Bác sĩ</h3>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
      <div style="background:#fff; padding:18px 20px; border-radius:12px;">
        <h5 style="font-size:14.5px; font-weight:700; color:#0f172a; margin-bottom:6px;">❓ Tôi có được chọn bác sĩ khám theo yêu cầu không?</h5>
        <p style="font-size:13px; color:#64748b; line-height:1.5;">Hoàn toàn có! Bạn có thể xem hồ sơ kinh nghiệm và chọn đích danh bác sĩ mình mong muốn khi đặt lịch.</p>
      </div>
      <div style="background:#fff; padding:18px 20px; border-radius:12px;">
        <h5 style="font-size:14.5px; font-weight:700; color:#0f172a; margin-bottom:6px;">❓ Nếu bác sĩ có lịch mổ đột xuất thì sao?</h5>
        <p style="font-size:13px; color:#64748b; line-height:1.5;">Hệ thống MediBook sẽ gửi thông báo và nhân viên lễ tân sẽ liên hệ hỗ trợ bạn đổi sang bác sĩ cùng chuyên khoa hoặc dời giờ phù hợp.</p>
      </div>
    </div>
  </div>
</div>
