<div class="container" style="padding: 40px 20px 80px;" data-animate="fade-up">
  <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:20px; margin-bottom: 30px;">
    <div>
      <h1 class="section-title">Đội ngũ Bác sĩ chuyên khoa MediBook</h1>
      <p style="color: var(--text-muted);">Các bác sĩ giàu kinh nghiệm, tận tâm, phụ trách đầy đủ tất cả các chuyên khoa phòng khám</p>
    </div>

    <!-- Filter by Specialty -->
    <div style="display:flex; align-items:center; gap:10px;">
      <label style="font-size:14px; font-weight:700; color:#334155;">Lọc chuyên khoa:</label>
      <select onchange="if(this.value){ location.href='/doctors?specialty_id='+this.value; } else { location.href='/doctors'; }" class="form-control" style="width:auto; min-width:220px; height:42px;">
        <option value="">-- Tất cả chuyên khoa (<%= doctors ? doctors.length : 0 %> BS) --</option>
        <% (specialties || []).forEach(sp => { %>
          <option value="<%= sp.id %>" <%= typeof selectedSpecialtyId !== 'undefined' && selectedSpecialtyId == sp.id ? 'selected' : '' %>>
            <%= sp.name %>
          </option>
        <% }); %>
      </select>
    </div>
  </div>

  <div class="doctors-grid">
    <% doctors.forEach(doc => { %>
      <div class="doctor-card interactive-hover">
        <div class="doctor-card-top">
          <img src="/assets/images/doctor-<%= doc.id %>.jpg" alt="<%= doc.name %>" class="doctor-img" style="object-fit:cover;object-position:top center;">
          <button type="button" class="btn-favorite" data-doctor-id="<%= doc.id %>" data-doctor-name="<%= doc.name %>" title="Lưu bác sĩ">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          </button>
        </div>
        <div class="doctor-card-body">
          <h3 class="doctor-name">
            <a href="/doctors/<%= doc.id %>"><%= doc.name %></a>
          </h3>
          <div class="doctor-specialty"><%= doc.specialty_names || 'Nội tổng quát' %> &bull; <%= doc.room_number %></div>

          <div class="doctor-meta">
            <div class="doctor-rating">
              ⭐ <%= Number(doc.rating).toFixed(1) %>
              <span class="doctor-reviews-count">(<%= doc.rating_count %>)</span>
            </div>
            <span class="doctor-badge-exp"><%= doc.experience_years %>+ năm KN</span>
          </div>

          <div style="display:flex;gap:8px;margin-top:16px;">
            <a href="/doctors/<%= doc.id %>" class="btn btn-secondary btn-sm" style="flex:1;">Hồ sơ</a>
            <a href="/appointments/book?doctor_id=<%= doc.id %>" class="btn btn-primary btn-sm" style="flex:1;">Đặt lịch</a>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</div>
