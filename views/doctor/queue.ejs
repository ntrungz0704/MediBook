<div class="card-box">
  <div class="card-header-bar">
    <div>
      <h3 style="margin-bottom:2px;">Hàng đợi bệnh nhân phòng <%= doctor.room_number %></h3>
      <p style="color:var(--text-muted);font-size:13px;margin:0;">Bác sĩ phụ trách: <%= doctor.name %></p>
    </div>

    <div style="display:flex;gap:10px;">
      <a href="/doctor/queue" class="btn btn-secondary btn-sm">🔄 Làm mới hàng đợi</a>
      <a href="/receptionist/live-board" target="_blank" class="btn btn-outline btn-sm">📺 Mở màn hình gọi số</a>
    </div>
  </div>

  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>STT</th>
          <th>Độ ưu tiên</th>
          <th>Mã đặt lịch</th>
          <th>Họ tên & SĐT</th>
          <th>Giới tính / Tuổi</th>
          <th>Giờ hẹn</th>
          <th>Lý do khám / Bệnh sử</th>
          <th>Trạng thái</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (!queueList || queueList.length === 0) { %>
          <tr>
            <td colspan="9" style="text-align: center; padding: 40px; color: var(--text-muted);">
              Chưa có bệnh nhân nào check-in vào phòng khám hôm nay.
            </td>
          </tr>
        <% } else { %>
          <% queueList.forEach(q => { %>
            <tr style="<%= q.priority_level === 'emergency' ? 'background:#fef2f2; border-left: 4px solid #ef4444;' : (q.status === 'calling' ? 'background:#ecfdf5;' : (q.status === 'in_room' ? 'background:#eff6ff;' : '')) %>">
              <td>
                <span style="font-size: 16px; font-weight: 800; color: <%= q.priority_level === 'emergency' ? '#dc2626' : 'var(--primary)' %>;">
                  <%= q.queue_number %>
                </span>
              </td>
              <td>
                <%- getPriorityBadge(q.priority_level) %>
                <% if (q.priority_reason) { %>
                  <div style="font-size: 11px; color: #64748b; margin-top: 2px;"><%= q.priority_reason %></div>
                <% } %>
              </td>
              <td><code><%= q.booking_code %></code></td>
              <td>
                <strong><%= q.patient_name %></strong><br>
                <small class="text-muted"><%= q.patient_phone %></small>
              </td>
              <td>
                <%= q.patient_gender === 'male' ? 'Nam' : (q.patient_gender === 'female' ? 'Nữ' : 'Khác') %>
                <% if (q.patient_dob) { %>
                  (<%= new Date().getFullYear() - new Date(q.patient_dob).getFullYear() %>t)
                <% } %>
              </td>
              <td><%= q.start_time ? q.start_time.slice(0, 5) : '' %></td>
              <td>
                <div style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  <%= q.symptoms || 'Khám định kỳ' %>
                </div>
              </td>
              <td>
                <% if (q.status === 'waiting') { %>
                  <span class="badge badge-warning">Đang chờ</span>
                <% } else if (q.status === 'calling') { %>
                  <span class="badge badge-primary">Đang gọi loa</span>
                <% } else if (q.status === 'in_room') { %>
                  <span class="badge badge-info">Đang khám</span>
                <% } else if (q.status === 'completed') { %>
                  <span class="badge badge-success">Đã khám xong</span>
                <% } else { %>
                  <span class="badge badge-secondary"><%= q.status %></span>
                <% } %>
              </td>
              <td>
                <div style="display:flex; gap:6px;">
                  <% if (q.status === 'waiting') { %>
                    <form action="/doctor/queue/call/<%= q.id %>" method="POST">
                      <button type="submit" class="btn btn-primary btn-sm">Gọi bệnh nhân</button>
                    </form>
                    <form action="/doctor/queue/skip/<%= q.id %>" method="POST">
                      <button type="submit" class="btn btn-secondary btn-sm" title="Tạm qua lượt">Qua lượt</button>
                    </form>
                  <% } else if (q.status === 'calling') { %>
                    <form action="/doctor/queue/start/<%= q.id %>" method="POST">
                      <button type="submit" class="btn btn-primary btn-sm" style="background:#0284c7;">Vào phòng khám</button>
                    </form>
                  <% } else if (q.status === 'in_room') { %>
                    <a href="/doctor/examine/<%= q.appointment_id %>" class="btn btn-primary btn-sm">
                      Mở hồ sơ khám &rarr;
                    </a>
                  <% } else { %>
                    <a href="/doctor/examine/<%= q.appointment_id %>" class="btn btn-secondary btn-sm">
                      Xem lại kết quả
                    </a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
