<div class="youmed-page-header">
  <div class="container">
    <div class="breadcrumbs-bar">
      <a href="/">Trang chủ</a> <span>&bull;</span> <span>Trợ lý y khoa & Liên hệ</span>
    </div>
    <h1 class="page-title">Liên hệ với MediBook - Trợ lý y khoa</h1>
    <p class="page-subtitle">Gửi câu hỏi cho phòng khám; chúng tôi sẽ liên hệ lại theo thông tin bạn cung cấp.</p>
  </div>
</div>

<div class="container" style="padding: 30px 20px 80px;" data-animate="fade-up">

  <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: start;">
    
    <!-- Left Column: Contact Form -->
    <div class="card-box interactive-hover" style="padding: 36px;">
      <h2 style="font-size: 20px; font-weight: 800; color: #0f172a; margin-bottom: 8px;">
        Gửi tin nhắn hoặc yêu cầu hỗ trợ
      </h2>
      <p style="color: var(--text-muted); font-size: 13.5px; margin-bottom: 24px;">
        Vui lòng điền thông tin bên dưới. Yêu cầu của bạn sẽ được lưu để nhân viên phụ trách xử lý.
      </p>

      <form action="/contact" method="POST">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
          <div class="form-group">
            <label>Họ và tên <span style="color:red;">*</span></label>
            <input type="text" name="name" class="form-control" value="<%= (currentUser && currentUser.name) || '' %>" placeholder="VD: Nguyễn Văn A" required>
          </div>
          <div class="form-group">
            <label>Số điện thoại <span style="color:red;">*</span></label>
            <input type="tel" name="phone" class="form-control" value="<%= (currentUser && currentUser.phone) || '' %>" placeholder="VD: 0901234567" required>
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
          <label>Địa chỉ Email <span style="color:red;">*</span></label>
          <input type="email" name="email" class="form-control" value="<%= (currentUser && currentUser.email) || '' %>" placeholder="name@example.com" required>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
          <label>Chủ đề liên hệ</label>
          <select name="subject" class="form-control">
            <option value="Tư vấn đặt lịch khám">Tư vấn chọn bác sĩ & Đặt lịch khám</option>
            <option value="Hỏi về bảng giá dịch vụ">Hỏi đáp về bảng giá & Chi phí khám chữa bệnh</option>
            <option value="Hỗ trợ kết quả khám bệnh">Hỏi về hồ sơ bệnh án & Kết quả thăm khám</option>
            <option value="Góp ý chất lượng dịch vụ">Góp ý chất lượng phục vụ phòng khám</option>
            <option value="Khác">Vấn đề khác</option>
          </select>
        </div>

        <div class="form-group" style="margin-bottom: 24px;">
          <label>Nội dung lời nhắn <span style="color:red;">*</span></label>
          <textarea name="message" rows="4" class="form-control" style="height:auto;" placeholder="Mô tả chi tiết câu hỏi hoặc yêu cầu hỗ trợ của bạn..." required></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" style="height: 48px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          Gửi thông tin liên hệ ngay
        </button>
      </form>
    </div>

    <!-- Right Column: Contact Details, Hotline & Working Hours -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      
      <!-- Quick Hotline Card -->
      <div class="card-box interactive-hover" style="padding: 28px; border-left: 5px solid var(--primary);">
        <h3 style="font-size: 18px; font-weight: 800; color: #0f172a; margin-bottom: 16px;">
          📞 Kênh liên hệ trực tiếp
        </h3>

        <div style="display: flex; flex-direction: column; gap: 16px; font-size: 14px;">
          <div style="display: flex; align-items: flex-start; gap: 14px;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: #ccfbf1; color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 18px;">
              📍
            </div>
            <div>
              <div style="font-weight: 700; color: #0f172a;">Địa chỉ phòng khám</div>
              <div style="color: #64748b;"><%= siteSettings.address || 'Chưa cập nhật' %></div>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 14px;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 18px;">
              ☎️
            </div>
            <div>
              <div style="font-weight: 700; color: #0f172a;">Tổng đài đặt lịch & Khẩn cấp</div>
              <div style="font-size: 16px; font-weight: 800; color: var(--primary);"><%= siteSettings.hotline || 'Chưa cập nhật' %></div>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 14px;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: #fef3c7; color: #d97706; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 18px;">
              ✉️
            </div>
            <div>
              <div style="font-weight: 700; color: #0f172a;">Thư điện tử (Email)</div>
              <div style="color: #64748b;"><%= siteSettings.email || 'Chưa cập nhật' %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Working Time Box -->
      <div class="card-box interactive-hover" style="padding: 24px; background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 100%);">
        <h4 style="font-size: 16px; font-weight: 800; color: var(--primary-dark); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
          ⏰ Giờ làm việc tiếp đón
        </h4>
        <p style="font-size: 13.5px; color: #334155;"><%= siteSettings.supportHours || 'Giờ hỗ trợ chưa được cập nhật.' %></p>
      </div>

    </div>

  </div>
</div>
