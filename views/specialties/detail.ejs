<div class="container" style="padding: 40px 20px 80px;">
  <div style="margin-bottom: 30px;">
    <a href="/specialties" style="color: var(--primary); font-weight: 600; font-size: 14px;">&larr; Tất cả chuyên khoa</a>
    <h1 class="section-title" style="margin-top: 10px;"><%= specialty.name %></h1>
    <p style="color: var(--text-muted); font-size: 16px;"><%= specialty.description %></p>
  </div>

  <!-- Services offered in this specialty -->
  <% if (services && services.length > 0) { %>
    <div class="card-box" style="padding: 24px; margin-bottom: 36px;">
      <h3 style="font-size: 18px; font-weight: 800; margin-bottom: 16px;">Dịch vụ thăm khám & Bảng giá</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
        <% services.forEach(srv => { %>
          <div style="border: 1px solid var(--border); border-radius: var(--radius-md); padding: 16px; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <div style="font-weight: 700; color: #0f172a; margin-bottom: 4px;"><%= srv.name %></div>
              <div style="font-size: 12.5px; color: var(--text-muted);">Thời lượng: <%= srv.duration_minutes %> phút</div>
            </div>
            <div style="font-size: 16px; font-weight: 800; color: var(--primary);">
              <%= formatCurrency(srv.price) %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Doctors in this specialty -->
  <h2 class="section-title" style="font-size: 22px; margin-bottom: 20px;">Bác sĩ phụ trách chuyên khoa</h2>
  <div class="doctors-grid">
    <% doctors.forEach(doc => { %>
      <div class="doctor-card interactive-hover">
        <div class="doctor-card-top">
          <img src="/assets/images/doctor-<%= doc.id %>.jpg" alt="<%= doc.name %>" class="doctor-img" style="object-fit:cover;object-position:top center;" onerror="this.onerror=null;this.src='/assets/images/doctor-1.jpg';">
          <button type="button" class="btn-favorite" data-doctor-id="<%= doc.id %>" data-doctor-name="<%= doc.name %>" title="Lưu bác sĩ">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          </button>
        </div>
        <div class="doctor-card-body">
          <h3 class="doctor-name">
            <a href="/doctors/<%= doc.id %>" style="color:inherit;"><%= doc.name %></a>
          </h3>
          <div class="doctor-specialty"><%= specialty.name %> &bull; <%= doc.room_number || 'Phòng chưa cập nhật' %></div>
          <div class="doctor-meta">
            <div class="doctor-rating">
              <%= doc.rating_count ? `⭐ ${Number(doc.rating).toFixed(1)}` : 'Chưa có đánh giá' %>
            </div>
            <span class="doctor-badge-exp"><%= doc.experience_years %>+ năm kinh nghiệm</span>
          </div>
          <div style="display:flex;gap:8px;margin-top:14px;">
            <a href="/doctors/<%= doc.id %>" class="btn btn-secondary btn-sm" style="flex:1;">Hồ sơ</a>
            <a href="/appointments/book?specialty_id=<%= specialty.id %>&doctor_id=<%= doc.id %>" class="btn btn-primary btn-sm" style="flex:1;">Đặt lịch</a>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</div>
