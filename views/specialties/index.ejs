<div class="container" style="padding: 40px 20px 80px;" data-animate="fade-up">
  <div style="margin-bottom: 35px; text-align:center; max-width:760px; margin-left:auto; margin-right:auto;">
    <span class="badge badge-primary" style="margin-bottom:10px; display:inline-block; font-size:12px; font-weight:700;">HỆ THỐNG KHOA LÂM SÀNG & CẬN LÂM SÀNG</span>
    <h1 class="section-title" style="font-size:32px; margin-bottom:12px;">Chuyên khoa phòng khám MediBook</h1>
    <p style="color: var(--text-muted); font-size:15.5px; line-height:1.6;">
      Trang thiết bị hiện đại, phòng khám vô trùng tiêu chuẩn quốc tế cùng đội ngũ bác sĩ chuyên khoa giàu kinh nghiệm luôn sẵn sàng phục vụ sức khỏe của bạn và gia đình.
    </p>
  </div>

  <!-- Specialties Grid -->
  <div class="specialties-grid">
    <% specialties.forEach(sp => { %>
      <a href="/specialties/<%= sp.slug %>" class="specialty-card interactive-hover" style="padding: 26px; border-radius:16px;">
        <div class="specialty-icon-circle" style="width: 60px; height: 60px; margin-bottom:16px;">
          <% if (sp.slug === 'tim-mach') { %>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.28"/></svg>
          <% } else if (sp.slug === 'nhi-khoa') { %>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
          <% } else if (sp.slug === 'san-phu-khoa') { %>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="8" r="5"/><path d="M12 13v8"/><path d="M9 18h6"/></svg>
          <% } else if (sp.slug === 'da-lieu') { %>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="4"/></svg>
          <% } else if (sp.slug === 'tai-mui-hong') { %>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 18h12M6 14h12M6 10h12M12 2v4"/></svg>
          <% } else if (sp.slug === 'co-xuong-khop') { %>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="5" r="3"/><path d="M12 8v8M9 12h6M8 21l4-5 4 5"/></svg>
          <% } else if (sp.slug === 'tieu-hoa') { %>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 12v6a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4v-6M12 2v10"/></svg>
          <% } else { %>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
          <% } %>
        </div>
        <div class="specialty-info">
          <h4 style="font-size: 18px; margin-bottom:6px;"><%= sp.name %></h4>
          <p style="font-size:13.5px; color:#64748b; line-height:1.5;"><%= sp.description %></p>
          <div style="margin-top:12px; display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size: 12.5px; font-weight: 700; color: var(--primary);">
              <%= sp.doctor_count || 1 %> Bác sĩ phụ trách &rarr;
            </span>
            <span style="font-size:11.5px; background:#f1f5f9; padding:3px 8px; border-radius:6px; color:#475569; font-weight:600;">Ưu tiên hẹn trước</span>
          </div>
        </div>
      </a>
    <% }); %>
  </div>

  <!-- SECTION BỔ SUNG 1: QUY TRÌNH THĂM KHÁM TIÊU CHUẨN -->
  <div style="margin-top: 60px; background: #ffffff; border-radius: 20px; padding: 40px 30px; border: 1px solid var(--border); box-shadow: var(--shadow-sm);" data-animate="fade-up">
    <div style="text-align: center; margin-bottom: 35px;">
      <h2 style="font-size: 24px; font-weight: 800; color: #0f172a; margin-bottom: 8px;">Quy trình khám chuyên khoa chuẩn mực tại MediBook</h2>
      <p style="color: #64748b; font-size: 14.5px;">Tiết kiệm thời gian, tiếp đón chuyên nghiệp, không phải chen lấn chờ đợi</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;">
      <div style="text-align: center; padding: 15px;">
        <div style="width: 50px; height: 50px; background: #e0f2fe; color: #0284c7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-weight: 800; font-size: 20px;">1</div>
        <h4 style="font-size: 16px; margin-bottom: 6px; font-weight: 700;">Đăng ký trực tuyến</h4>
        <p style="font-size: 13px; color: #64748b; line-height: 1.5;">Chọn chuyên khoa, chọn bác sĩ và giờ khám phù hợp với lịch của bạn.</p>
      </div>

      <div style="text-align: center; padding: 15px;">
        <div style="width: 50px; height: 50px; background: #ccfbf1; color: #0f766e; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-weight: 800; font-size: 20px;">2</div>
        <h4 style="font-size: 16px; margin-bottom: 6px; font-weight: 700;">Check-in tại quầy</h4>
        <p style="font-size: 13px; color: #64748b; line-height: 1.5;">Đọc mã lịch hẹn `MB...` cho lễ tân để nhận ngay số thứ tự vào phòng khám.</p>
      </div>

      <div style="text-align: center; padding: 15px;">
        <div style="width: 50px; height: 50px; background: #fef08a; color: #a16207; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-weight: 800; font-size: 20px;">3</div>
        <h4 style="font-size: 16px; margin-bottom: 6px; font-weight: 700;">Bác sĩ thăm khám</h4>
        <p style="font-size: 13px; color: #64748b; line-height: 1.5;">Bác sĩ kiểm tra sinh tồn, chẩn đoán tận tâm, tư vấn phác đồ điều trị chi tiết.</p>
      </div>

      <div style="text-align: center; padding: 15px;">
        <div style="width: 50px; height: 50px; background: #dcfce7; color: #15803d; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-weight: 800; font-size: 20px;">4</div>
        <h4 style="font-size: 16px; margin-bottom: 6px; font-weight: 700;">Nhận toa & Theo dõi</h4>
        <p style="font-size: 13px; color: #64748b; line-height: 1.5;">Nhận đơn thuốc điện tử lưu trên tài khoản, nhận thuốc tại quầy dược và ra về.</p>
      </div>
    </div>
  </div>

  <!-- SECTION BỔ SUNG 2: CAM KẾT CHẤT LƯỢNG & ĐẶT LỊCH NGAY -->
  <div style="margin-top: 40px; background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%); border-radius: 20px; padding: 40px 35px; color: #ffffff; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;" data-animate="fade-up">
    <div style="max-width: 650px;">
      <h3 style="font-size: 24px; font-weight: 800; margin-bottom: 8px;">Bạn đang gặp vấn đề về sức khỏe?</h3>
      <p style="font-size: 14.5px; opacity: 0.9; line-height: 1.6;">
        Đừng để bệnh kéo dài. Đội ngũ bác sĩ chuyên khoa giỏi luôn sẵn sàng lắng nghe, thăm khám và hỗ trợ chẩn đoán chính xác nhất.
      </p>
    </div>
    <div>
      <a href="/appointments/book" class="btn" style="background:#ffffff; color:#0d9488; font-weight:800; padding:12px 28px; box-shadow:0 10px 20px rgba(0,0,0,0.15);">
        Đặt lịch khám ngay &rarr;
      </a>
    </div>
  </div>
</div>
