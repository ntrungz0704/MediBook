<div style="max-width: 900px; margin: 0 auto;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <div>
      <a href="/admin/appointments" style="color:var(--primary); font-weight:600; font-size:14px;">&larr; Danh sách lịch hẹn</a>
      <h2 style="font-size:24px; font-weight:800; margin-top:4px;">Chi tiết lịch khám #<%= app.booking_code %></h2>
    </div>

    <div>
      <%- getStatusBadge(app.status) %>
    </div>
  </div>

  <div class="card-box" style="padding: 24px; margin-bottom: 24px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid var(--border-light); padding-bottom:8px;">
      <h3 style="font-size: 17px; font-weight: 700; margin:0;">
        Thông tin đặt khám & Bệnh nhân
      </h3>
      <%- getPriorityBadge(app.priority_level) %>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 14px;">
      <div>Bệnh nhân: <strong><%= app.patient_name %></strong></div>
      <div>Số điện thoại: <strong><%= app.patient_phone %></strong></div>
      <div>Bác sĩ: <strong><%= app.doctor_name %></strong></div>
      <div>Phòng khám: <strong><%= app.room_number %> (<%= app.specialty_name %>)</strong></div>
      <div>Ngày khám: <strong><%= formatDate(app.appointment_date) %></strong> &bull; <%= app.start_time %> - <%= app.end_time %></div>
      <div>Dịch vụ: <%= app.service_name || 'Khám tiêu chuẩn' %></div>
      <% if (app.priority_reason) { %>
        <div>Lý do ưu tiên: <span style="color:#d97706; font-weight:600;"><%= app.priority_reason %></span></div>
      <% } %>
      <div style="grid-column: 1/-1;">Triệu chứng: <%= app.symptoms || 'Không ghi nhận' %></div>
    </div>
  </div>

  <!-- Medical Record & Inpatient / Outpatient Examination -->
  <% if (typeof medicalRecord !== 'undefined' && medicalRecord) { %>
    <div class="card-box" style="padding: 24px; margin-bottom: 24px; border-top: 3px solid var(--primary);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid var(--border-light); padding-bottom:8px;">
        <h3 style="font-size: 17px; font-weight: 700; margin:0; color:#0f172a;">
          🩺 Hồ sơ bệnh án & Kết quả thăm khám
        </h3>
        <div style="display:flex; gap:8px;">
          <%- getVisitTypeBadge(medicalRecord.visit_type) %>
          <%- getTreatmentTypeBadge(medicalRecord.treatment_type) %>
        </div>
      </div>

      <% if (medicalRecord.treatment_type === 'inpatient') { %>
        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 14px 18px; margin-bottom: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; font-size: 13.5px;">
          <div><span style="color:#92400e; font-weight:600;">Phòng điều trị:</span> <strong><%= medicalRecord.inpatient_room || 'Chưa xếp' %></strong></div>
          <div><span style="color:#92400e; font-weight:600;">Giường bệnh:</span> <strong><%= medicalRecord.inpatient_bed || 'Chưa xếp' %></strong></div>
          <div><span style="color:#92400e; font-weight:600;">Ngày nhập viện:</span> <strong><%= formatDate(medicalRecord.admission_date) %></strong></div>
          <div><span style="color:#92400e; font-weight:600;">Dự kiến xuất viện:</span> <strong><%= medicalRecord.discharge_date ? formatDate(medicalRecord.discharge_date) : 'Đang điều trị' %></strong></div>
        </div>
      <% } %>

      <div style="margin-bottom: 14px;">
        <div style="font-size: 13px; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Chẩn đoán lâm sàng:</div>
        <div style="font-size: 16px; font-weight: 700; color: #0f172a; margin-top: 2px;">
          <%= medicalRecord.clinical_diagnosis %>
          <% if (medicalRecord.icd10_code) { %>
            <span class="badge badge-info" style="font-size: 11.5px; margin-left: 8px;">ICD-10: <%= medicalRecord.icd10_code %></span>
          <% } %>
        </div>
      </div>

      <% if (medicalRecord.doctor_notes) { %>
        <div style="background: #f8fafc; padding: 12px 16px; border-radius: 6px; border: 1px solid var(--border); font-size: 13.5px; margin-bottom: 16px;">
          <strong>Lời dặn bác sĩ:</strong> <%= medicalRecord.doctor_notes %>
        </div>
      <% } %>

      <!-- Prescription Items Table -->
      <% if (typeof prescriptionItems !== 'undefined' && prescriptionItems.length > 0) { %>
        <h4 style="font-size: 15px; font-weight: 700; margin-bottom: 10px; color:#0f172a;">
          💊 Đơn thuốc đã kê (#<%= prescription.prescription_code %>)
        </h4>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Tên thuốc</th>
                <th>Liều dùng</th>
                <th>Đơn vị</th>
                <th>Số lượng</th>
                <th>Chia cữ (S - T - C - Tối)</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
              </tr>
            </thead>
            <tbody>
              <% prescriptionItems.forEach(item => { %>
                <tr>
                  <td><strong><%= item.medicine_name %></strong></td>
                  <td><%= item.dosage %></td>
                  <td><%= item.unit %></td>
                  <td><%= item.quantity %></td>
                  <td><%= item.morning %> - <%= item.noon %> - <%= item.afternoon %> - <%= item.night %></td>
                  <td><%= formatCurrency(item.unit_price) %></td>
                  <td style="font-weight:700; color:var(--primary);"><%= formatCurrency(item.amount) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div style="text-align:right; font-weight:700; font-size:15px; margin-top:10px;">
          Tổng tiền thuốc: <span style="color:var(--primary); font-size:17px;"><%= formatCurrency(prescription.total_amount) %></span>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Status History Timeline -->
  <div class="card-box" style="padding: 24px; margin-bottom: 24px;">
    <h3 style="font-size: 17px; font-weight: 700; margin-bottom: 16px; border-bottom: 1px solid var(--border-light); padding-bottom: 8px;">
      Nhật ký thay đổi trạng thái
    </h3>

    <div style="display:flex; flex-direction:column; gap:12px; font-size:13.5px;">
      <% (history || []).forEach(h => { %>
        <div style="border-left: 3px solid var(--primary); padding-left: 12px;">
          <div style="font-weight:700; color:#0f172a;">
            Chuyển thành: <%- getStatusBadge(h.new_status) %>
            <span style="font-weight:normal; font-size:12px; color:var(--text-muted); margin-left:8px;"><%= formatDateTime(h.created_at) %></span>
          </div>
          <div style="color:#475569; margin-top:2px;">
            <%= h.note || 'Cập nhật hệ thống' %>
            <% if (h.changed_by_name) { %>
              &bull; <em>Thực hiện bởi: <%= h.changed_by_name %> (<%= h.changed_by_role %>)</em>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <!-- Manual Status Override by Admin -->
  <div class="card-box" style="padding: 20px;">
    <h4 style="font-size: 16px; font-weight: 700; margin-bottom: 12px;">Điều chỉnh trạng thái thủ công (Admin Override)</h4>
    <form action="/admin/appointments/status/<%= app.id %>" method="POST" style="display:flex; gap:12px; align-items:center;">
      <select name="status" class="form-control" style="max-width:200px;">
        <option value="pending" <%= app.status === 'pending' ? 'selected' : '' %>>Chờ xác nhận</option>
        <option value="confirmed" <%= app.status === 'confirmed' ? 'selected' : '' %>>Đã xác nhận</option>
        <option value="checked_in" <%= app.status === 'checked_in' ? 'selected' : '' %>>Đã tiếp đón</option>
        <option value="in_consultation" <%= app.status === 'in_consultation' ? 'selected' : '' %>>Đang khám</option>
        <option value="completed" <%= app.status === 'completed' ? 'selected' : '' %>>Đã hoàn thành</option>
        <option value="cancelled" <%= app.status === 'cancelled' ? 'selected' : '' %>>Đã hủy</option>
      </select>
      <input type="text" name="note" class="form-control" placeholder="Lý do điều chỉnh...">
      <button type="submit" class="btn btn-primary btn-sm" style="white-space:nowrap;">Lưu trạng thái</button>
    </form>
  </div>
</div>
