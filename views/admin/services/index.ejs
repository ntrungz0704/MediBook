<div class="card-box">
  <div class="card-header-bar">
    <h3>Danh mục dịch vụ khám & Bảng giá (<%= services ? services.length : 0 %> dịch vụ)</h3>
    <a href="/admin/services/create" class="btn btn-primary btn-sm">➕ Thêm dịch vụ mới</a>
  </div>

  <div style="margin: 15px 0 20px;">
    <input type="text" id="service_search" placeholder="🔍 Nhập tên dịch vụ, chuyên khoa để lọc nhanh..." class="form-control" style="max-width: 420px; padding: 9px 14px; border-radius: 8px; font-size: 13.5px; border: 1px solid #cbd5e1;">
  </div>

  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Tên dịch vụ</th>
          <th>Chuyên khoa</th>
          <th>Thời lượng</th>
          <th>Bảng giá niêm yết</th>
          <th>Trạng thái</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (!services || services.length === 0) { %>
          <tr><td colspan="7" style="text-align:center;padding:20px;">Không có dịch vụ nào.</td></tr>
        <% } else { %>
          <% services.forEach(s => { %>
            <tr>
              <td><%= s.id %></td>
              <td><strong><%= s.name %></strong></td>
              <td><span class="badge badge-info"><%= s.specialty_name %></span></td>
              <td><%= s.duration_minutes %> phút</td>
              <td><strong style="color:var(--primary); font-size:15px;"><%= formatCurrency(s.price) %></strong></td>
              <td><span class="badge badge-success"><%= s.status %></span></td>
              <td>
                <a href="/admin/services/edit/<%= s.id %>" class="btn btn-secondary btn-sm">Sửa</a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.getElementById('service_search')?.addEventListener('input', function(e) {
    const q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.data-table tbody tr').forEach(row => {
      const text = row.textContent.toLowerCase();
      row.style.display = text.includes(q) ? '' : 'none';
    });
  });
</script>
