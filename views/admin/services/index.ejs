<div class="card-box">
  <div class="card-header-bar">
    <h3>Danh mục dịch vụ khám & Bảng giá (<%= services ? services.length : 0 %> dịch vụ)</h3>
    <a href="/admin/services/create" class="btn btn-primary btn-sm">➕ Thêm dịch vụ mới</a>
  </div>

  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Tên dịch vụ</th>
          <th>Chuyên khoa</th>
          <th>Thời lượng</th>
          <th>Bảng giá niêm yết</th>
          <th>Trạng thái</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (!services || services.length === 0) { %>
          <tr><td colspan="7" style="text-align:center;padding:20px;">Không có dịch vụ nào.</td></tr>
        <% } else { %>
          <% services.forEach(s => { %>
            <tr>
              <td><%= s.id %></td>
              <td><strong><%= s.name %></strong></td>
              <td><span class="badge badge-info"><%= s.specialty_name %></span></td>
              <td><%= s.duration_minutes %> phút</td>
              <td><strong style="color:var(--primary); font-size:15px;"><%= formatCurrency(s.price) %></strong></td>
              <td><span class="badge badge-success"><%= s.status %></span></td>
              <td>
                <a href="/admin/services/edit/<%= s.id %>" class="btn btn-secondary btn-sm">Sửa</a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
