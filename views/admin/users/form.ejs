<% const isEdit = typeof user !== 'undefined' && user; %>
<div class="card-box" style="max-width: 680px; padding: 30px; margin: 0 auto;">
  <h2 style="font-size: 20px; font-weight: 800; margin-bottom: 20px; border-bottom: 1px solid var(--border-light); padding-bottom: 12px;">
    <%= isEdit ? 'Chỉnh sửa tài khoản người dùng' : 'Thêm tài khoản người dùng mới' %>
  </h2>

  <form action="<%= isEdit ? '/admin/users/update/' + user.id : '/admin/users/store' %>" method="POST">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
      <div class="form-group">
        <label>Họ và tên <span style="color:red;">*</span></label>
        <input type="text" name="name" class="form-control" value="<%= isEdit ? user.name : '' %>" required>
      </div>

      <div class="form-group">
        <label>Số điện thoại <span style="color:red;">*</span></label>
        <input type="tel" name="phone" class="form-control" value="<%= isEdit ? user.phone : '' %>" required>
      </div>
    </div>

    <div class="form-group" style="margin-bottom: 16px;">
      <label>Địa chỉ Email <span style="color:red;">*</span></label>
      <input type="email" name="email" class="form-control" value="<%= isEdit ? user.email : '' %>" required>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
      <div class="form-group">
        <label>Trạng thái tài khoản</label>
        <select name="status" class="form-control">
          <option value="active" <%= isEdit && user.status === 'active' ? 'selected' : '' %>>Hoạt động</option>
          <option value="inactive" <%= isEdit && user.status === 'inactive' ? 'selected' : '' %>>Khóa tài khoản</option>
        </select>
      </div>

      <div class="form-group">
        <label>Mật khẩu <%= isEdit ? '(Để trống nếu không đổi)' : '<span style="color:red;">*</span>' %></label>
        <input type="password" name="password" class="form-control" placeholder="<%= isEdit ? '••••••••' : 'Nhập mật khẩu ít nhất 6 ký tự' %>" <%= isEdit ? '' : 'required minlength="6"' %>>
      </div>
    </div>

    <!-- Multi-role selection -->
    <div class="form-group" style="margin-bottom: 24px;">
      <label style="font-weight: 700; font-size: 14px; margin-bottom: 8px; display: block; color: #0f172a;">
        Phân quyền vai trò (Hỗ trợ 1 người có nhiều vai trò) <span style="color:red;">*</span>
      </label>
      <% 
        const currentRoles = (isEdit && user.roles && user.roles.length > 0) ? user.roles : (isEdit && user.role ? [user.role] : ['patient']);
      %>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; background: #f8fafc; padding: 14px; border-radius: 8px; border: 1px solid var(--border);">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13.5px; font-weight: 600;">
          <input type="checkbox" name="roles[]" value="admin" <%= currentRoles.includes('admin') ? 'checked' : '' %>>
          <span>🛡️ Quản trị viên</span>
        </label>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13.5px; font-weight: 600;">
          <input type="checkbox" name="roles[]" value="doctor" <%= currentRoles.includes('doctor') ? 'checked' : '' %>>
          <span>🩺 Bác sĩ</span>
        </label>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13.5px; font-weight: 600;">
          <input type="checkbox" name="roles[]" value="receptionist" <%= currentRoles.includes('receptionist') ? 'checked' : '' %>>
          <span>📋 Lễ tân</span>
        </label>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13.5px; font-weight: 600;">
          <input type="checkbox" name="roles[]" value="patient" <%= currentRoles.includes('patient') ? 'checked' : '' %>>
          <span>👤 Bệnh nhân</span>
        </label>
      </div>
      <small style="color: var(--text-muted); display: block; margin-top: 6px;">
        * Một người có thể đảm nhận nhiều vai trò cùng lúc (ví dụ vừa là Bác sĩ vừa là Bệnh nhân, hoặc Admin kiêm Bác sĩ).
      </small>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 12px;">
      <a href="/admin/users" class="btn btn-secondary">Hủy</a>
      <button type="submit" class="btn btn-primary">
        <%= isEdit ? 'Cập nhật tài khoản' : 'Tạo tài khoản' %>
      </button>
    </div>
  </form>
</div>
