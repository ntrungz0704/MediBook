<div class="container" style="max-width: 800px; padding: 40px 20px 80px;">
  <h1 style="font-size: 26px; font-weight: 800; color: #0f172a; margin-bottom: 24px;">Hồ sơ cá nhân</h1>

  <div class="card-box" style="padding: 30px; margin-bottom: 30px;">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px; border-bottom: 1px solid var(--border-light); padding-bottom: 10px;">
      Thông tin tài khoản & Y tế
    </h3>

    <form action="/profile" method="POST">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
        <div class="form-group">
          <label>Họ và tên <span style="color:red;">*</span></label>
          <input type="text" name="name" class="form-control" value="<%= user.name %>" required>
        </div>
        <div class="form-group">
          <label>Số điện thoại <span style="color:red;">*</span></label>
          <input type="tel" name="phone" class="form-control" value="<%= user.phone || '' %>" required>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <label>Địa chỉ Email (Không đổi)</label>
        <input type="email" class="form-control" value="<%= user.email %>" disabled style="background:#f1f5f9;">
      </div>

      <% if (user.role === 'patient') { %>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px;">
          <div class="form-group">
            <label>Ngày sinh</label>
            <input type="date" name="dob" class="form-control" value="<%= (patient && patient.dob) || '' %>">
          </div>
          <div class="form-group">
            <label>Giới tính</label>
            <select name="gender" class="form-control">
              <option value="male" <%= (patient && patient.gender === 'male') ? 'selected' : '' %>>Nam</option>
              <option value="female" <%= (patient && patient.gender === 'female') ? 'selected' : '' %>>Nữ</option>
              <option value="other" <%= (patient && patient.gender === 'other') ? 'selected' : '' %>>Khác</option>
            </select>
          </div>
          <div class="form-group">
            <label>Nhóm máu</label>
            <input type="text" name="blood_group" class="form-control" placeholder="A, B, AB, O..." value="<%= (patient && patient.blood_group) || '' %>">
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
          <label>Mã thẻ BHYT (Nếu có)</label>
          <input type="text" name="health_insurance_no" class="form-control" placeholder="VD: DN479..." value="<%= (patient && patient.health_insurance_no) || '' %>">
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
          <label>Địa chỉ thường trú</label>
          <input type="text" name="address" class="form-control" placeholder="Số nhà, tên đường, quận/huyện, tỉnh/thành" value="<%= (patient && patient.address) || '' %>">
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
          <label>Người liên hệ khẩn cấp</label>
          <input type="text" name="emergency_contact" class="form-control" placeholder="Họ tên người thân - SĐT" value="<%= (patient && patient.emergency_contact) || '' %>">
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
          <label>Tiền sử dị ứng & bệnh mạn tính</label>
          <textarea name="medical_history" rows="2" class="form-control" placeholder="Dị ứng thuốc, thức ăn, hen suyễn, tiểu đường..."><%= (patient && patient.medical_history) || '' %></textarea>
        </div>
      <% } %>

      <button type="submit" class="btn btn-primary">
        Lưu thông tin hồ sơ
      </button>
    </form>
  </div>

  <!-- Change Password Box -->
  <div class="card-box" style="padding: 30px;">
    <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px; border-bottom: 1px solid var(--border-light); padding-bottom: 10px;">
      Đổi mật khẩu bảo vệ
    </h3>

    <form action="/profile/password" method="POST">
      <div class="form-group" style="margin-bottom: 16px;">
        <label>Mật khẩu hiện tại</label>
        <input type="password" name="current_password" class="form-control" placeholder="••••••••" required>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
        <div class="form-group">
          <label>Mật khẩu mới</label>
          <input type="password" name="new_password" class="form-control" placeholder="Ít nhất 8 ký tự" required minlength="8">
        </div>
        <div class="form-group">
          <label>Nhập lại mật khẩu mới</label>
          <input type="password" name="new_password_confirmation" class="form-control" placeholder="••••••••" required minlength="8">
        </div>
      </div>

      <button type="submit" class="btn btn-secondary">
        Cập nhật mật khẩu
      </button>
    </form>
  </div>

  <% if (user.role === 'patient') { %>
    <!-- Favorite Doctors Section -->
    <div class="card-box" style="padding: 30px; margin-top: 30px;">
      <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 20px; border-bottom: 1px solid var(--border-light); padding-bottom: 10px; display:flex; justify-content:space-between; align-items:center;">
        <span>❤️ Bác sĩ yêu thích của bạn</span>
        <span style="font-size:13px; font-weight:600; color:var(--text-muted);"><%= (typeof favoriteDoctors !== 'undefined' && favoriteDoctors) ? favoriteDoctors.length : 0 %> bác sĩ</span>
      </h3>

      <% if (typeof favoriteDoctors === 'undefined' || !favoriteDoctors || favoriteDoctors.length === 0) { %>
        <div style="text-align: center; padding: 30px 10px; color: var(--text-muted);">
          <div style="font-size: 32px; margin-bottom: 8px;">🩺</div>
          <p style="margin: 0; font-size: 14px;">Bạn chưa lưu bác sĩ nào vào danh sách yêu thích.</p>
          <a href="/doctors" class="btn btn-outline btn-sm" style="margin-top: 14px;">Khám phá đội ngũ bác sĩ &rarr;</a>
        </div>
      <% } else { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px;">
          <% favoriteDoctors.forEach(doc => { %>
            <div style="background: #f8fafc; border: 1px solid var(--border); border-radius: 12px; padding: 16px; display: flex; flex-direction: column; align-items: center; text-align: center;">
              <img src="/assets/images/doctor-<%= doc.id %>.jpg" alt="<%= doc.name %>" style="width: 70px; height: 70px; border-radius: 50%; object-fit: cover; margin-bottom: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.08);">
              <h4 style="font-size: 15px; font-weight: 700; color: #0f172a; margin-bottom: 4px;">
                <a href="/doctors/<%= doc.id %>" style="color:inherit;"><%= doc.name %></a>
              </h4>
              <div style="font-size: 12.5px; color: var(--text-muted); margin-bottom: 8px;">
                <%= doc.specialty_names || 'Nội tổng quát' %> &bull; <%= doc.room_number %>
              </div>
              <div style="font-size: 12px; font-weight: 700; color: #0d9488; margin-bottom: 12px;">
                ⭐ <%= Number(doc.rating).toFixed(1) %> &bull; <%= formatCurrency(doc.consultation_fee) %>
              </div>
              <div style="display: flex; gap: 8px; width: 100%;">
                <a href="/doctors/<%= doc.id %>" class="btn btn-secondary btn-sm" style="flex: 1; padding: 6px 8px; font-size: 12px;">Hồ sơ</a>
                <a href="/appointments/book?doctor_id=<%= doc.id %>" class="btn btn-primary btn-sm" style="flex: 1; padding: 6px 8px; font-size: 12px;">Đặt lịch</a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
