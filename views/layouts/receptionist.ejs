<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Lễ tân - MediBook' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/dashboard.css">
</head>
<body>
  <div class="dashboard-container">
    <aside class="dashboard-sidebar">
      <div class="sidebar-header" style="padding: 0 16px;">
        <a href="/receptionist/dashboard" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit;">
          <div class="brand-icon" style="width: 36px; height: 36px; min-width: 36px; border-radius: 6px; background:#fff; padding:2px;">
            <img src="/assets/images/logo.png" alt="MediBook Logo" class="brand-img">
          </div>
          <div style="display:flex; flex-direction:column; line-height:1.2;">
            <span style="font-size: 17px; font-weight: 700; color: #ffffff; letter-spacing: -0.3px;">Medi<span style="color:#0284c7;">Book</span></span>
            <span style="font-size: 10px; font-weight: 600; color: #94a3b8; letter-spacing: 0.5px;">QUẦY TIẾP ĐÓN</span>
          </div>
        </a>
        <span class="sidebar-role-badge role-receptionist" style="margin-left: auto;">Lễ tân</span>
      </div>

      <ul class="sidebar-nav">
        <li><a href="/receptionist/dashboard" class="<%= currentPath === '/receptionist/dashboard' || currentPath === '/receptionist' ? 'active' : '' %>"><span>📊</span> Bàn làm việc lễ tân</a></li>
        <li><a href="/receptionist/checkin" class="<%= currentPath.startsWith('/receptionist/checkin') ? 'active' : '' %>"><span>📋</span> Tiếp đón & Điểm danh</a></li>
        <li><a href="/receptionist/booking" class="<%= currentPath.startsWith('/receptionist/booking') ? 'active' : '' %>"><span>➕</span> Đặt lịch tại quầy</a></li>
        <li><a href="/receptionist/payments" class="<%= currentPath.startsWith('/receptionist/payments') ? 'active' : '' %>"><span>💳</span> Thu ngân & Viện phí</a></li>
        <li><a href="/receptionist/live-board" target="_blank"><span>📺</span> Màn hình gọi số sảnh</a></li>
        <li style="margin-top:14px; border-top: 1px solid rgba(255,255,255,0.08); padding-top:10px;"><a href="/" target="_blank"><span>🌐</span> Xem trang chủ</a></li>
      </ul>

      <div class="sidebar-footer">
        <span style="font-size:13px;"><%= currentUser ? currentUser.name : 'Lễ tân' %></span>
        <a href="/logout" style="color:#ef4444;font-size:13px;font-weight:700;">Đăng xuất</a>
      </div>
    </aside>

    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="topbar-title">
          <h2><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Bàn làm việc Lễ tân' %></h2>
        </div>
        <div class="topbar-user" style="display:flex; align-items:center; gap:16px;">
          <% if (currentUser && currentUser.roles && currentUser.roles.length > 1) { %>
            <div style="display:inline-flex; align-items:center; gap:6px; background:#eff6ff; border:1px solid #bfdbfe; border-radius:20px; padding:4px 12px; font-size:12px; font-weight:600; color:#1d4ed8;">
              <span>🎭 Vai trò:</span>
              <select onchange="window.location.href='/switch-role/' + this.value" style="background:transparent; border:none; font-weight:700; color:#1d4ed8; cursor:pointer; outline:none; font-size:12px;">
                <% currentUser.roles.forEach(r => { %>
                  <option value="<%= r %>" <%= currentUser.role === r ? 'selected' : '' %>>
                    <%= r === 'admin' ? '🛡️ Quản trị viên' : r === 'doctor' ? '🩺 Bác sĩ' : r === 'receptionist' ? '📋 Lễ tân' : '👤 Bệnh nhân' %>
                  </option>
                <% }); %>
              </select>
            </div>
          <% } %>
          <div class="user-avatar-circle" style="background:#e0f2fe;color:#0369a1;">LT</div>
          <span style="font-weight:600;"><%= currentUser ? currentUser.name : 'Lễ tân' %></span>
        </div>
      </header>

      <% if (flashSuccess || flashError || flashInfo) { %>
        <div style="padding: 20px 30px 0;">
          <% if (flashSuccess) { %>
            <div class="alert alert-success"><%= flashSuccess %></div>
          <% } %>
          <% if (flashError) { %>
            <div class="alert alert-error"><%= flashError %></div>
          <% } %>
          <% if (flashInfo) { %>
            <div class="alert alert-info"><%= flashInfo %></div>
          <% } %>
        </div>
      <% } %>

      <main class="dashboard-content">
        <%- body %>
      </main>
    </div>
  </div>

  <script src="/assets/js/app.js"></script>
</body>
</html>
