<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Bác sĩ - MediBook' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/dashboard.css">
</head>
<body>
  <div class="dashboard-container">
    <aside class="dashboard-sidebar">
      <div class="sidebar-header" style="padding: 0 16px;">
        <a href="/doctor/dashboard" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit;">
          <div class="brand-icon" style="width: 36px; height: 36px; min-width: 36px; border-radius: 6px; background:#fff; padding:2px;">
            <img src="/assets/images/logo.png" alt="MediBook Logo" class="brand-img">
          </div>
          <div style="display:flex; flex-direction:column; line-height:1.2;">
            <span style="font-size: 17px; font-weight: 700; color: #ffffff; letter-spacing: -0.3px;">Medi<span style="color:#0284c7;">Book</span></span>
            <span style="font-size: 10px; font-weight: 600; color: #94a3b8; letter-spacing: 0.5px;">BÁC SĨ ĐIỀU TRỊ</span>
          </div>
        </a>
        <span class="sidebar-role-badge role-doctor" style="margin-left: auto;">Bác sĩ</span>
      </div>

      <ul class="sidebar-nav">
        <li><a href="/doctor/dashboard" class="<%= currentPath === '/doctor/dashboard' || currentPath === '/doctor' ? 'active' : '' %>"><span>📊</span> Tổng quan ca trực</a></li>
        <li><a href="/doctor/queue" class="<%= currentPath.startsWith('/doctor/queue') ? 'active' : '' %>"><span>🩺</span> Hàng đợi khám bệnh</a></li>
        <li><a href="/doctor/schedule" class="<%= currentPath.startsWith('/doctor/schedule') ? 'active' : '' %>"><span>📅</span> Ca trực & Xin nghỉ</a></li>
        <li style="margin-top:14px; border-top: 1px solid rgba(255,255,255,0.08); padding-top:10px;"><a href="/" target="_blank"><span>🌐</span> Xem trang chủ</a></li>
      </ul>

      <div class="sidebar-footer">
        <span style="font-size:13px;"><%= currentUser ? currentUser.name : 'Bác sĩ' %></span>
        <a href="/logout" style="color:#ef4444;font-size:13px;font-weight:700;">Đăng xuất</a>
      </div>
    </aside>

    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="topbar-title">
          <h2><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Khu vực làm việc Bác sĩ' %></h2>
        </div>
        <div class="topbar-user" style="display:flex; align-items:center; gap:16px;">
          <% if (currentUser && currentUser.role === 'admin') { %>
            <a href="/admin/dashboard" class="btn btn-secondary btn-sm" style="display:inline-flex; align-items:center; gap:6px; font-size:12.5px; padding:5px 12px; border-radius:6px; text-decoration:none; background:#f1f5f9; border:1px solid #cbd5e1; color:#0f172a; font-weight:600;">
              <span>🛡️</span> Về Bảng Quản Trị
            </a>
          <% } %>
          <% if (currentUser && currentUser.roles && currentUser.roles.length > 1) { %>
            <div style="display:inline-flex; align-items:center; gap:6px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:20px; padding:4px 12px; font-size:12px; font-weight:600; color:#166534;">
              <span>🎭 Vai trò:</span>
              <select onchange="window.location.href='/switch-role/' + this.value" style="background:transparent; border:none; font-weight:700; color:#166534; cursor:pointer; outline:none; font-size:12px;">
                <% currentUser.roles.forEach(r => { %>
                  <option value="<%= r %>" <%= currentUser.role === r ? 'selected' : '' %>>
                    <%= r === 'admin' ? '🛡️ Quản trị viên' : r === 'doctor' ? '🩺 Bác sĩ' : r === 'receptionist' ? '📋 Lễ tân' : '👤 Bệnh nhân' %>
                  </option>
                <% }); %>
              </select>
            </div>
          <% } %>
          <div class="user-avatar-circle" style="background:<%= currentUser && currentUser.role === 'admin' ? '#fef3c7;color:#b45309;' : '#ccfbf1;color:#0f766e;' %>">
            <%= currentUser && currentUser.role === 'admin' ? 'AD' : 'BS' %>
          </div>
          <span style="font-weight:600;"><%= currentUser ? currentUser.name : 'Bác sĩ' %></span>
        </div>
      </header>

      <% if (flashSuccess || flashError || flashInfo) { %>
        <div style="padding: 20px 30px 0;">
          <% if (flashSuccess) { %>
            <div class="alert alert-success"><%= flashSuccess %></div>
          <% } %>
          <% if (flashError) { %>
            <div class="alert alert-error"><%= flashError %></div>
          <% } %>
          <% if (flashInfo) { %>
            <div class="alert alert-info"><%= flashInfo %></div>
          <% } %>
        </div>
      <% } %>

      <main class="dashboard-content">
        <%- body %>
      </main>
    </div>
  </div>

  <script src="/assets/js/app.js"></script>
</body>
</html>
