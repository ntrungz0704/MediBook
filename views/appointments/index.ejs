<div class="container" style="max-width: 960px; padding: 40px 20px 80px;">
  
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px;">
    <div>
      <h1 style="font-size: 26px; font-weight: 800; color: #0f172a;">Lịch khám của tôi</h1>
      <p style="color: var(--text-muted);">Quản lý tất cả cuộc hẹn và hồ sơ bệnh án trực tuyến</p>
    </div>
    <a href="/appointments/book" class="btn btn-primary">
      ➕ Đặt lịch khám mới
    </a>
  </div>

  <% if (!appointments || appointments.length === 0) { %>
    <div class="card-box" style="padding: 60px 20px; text-align: center;">
      <div style="font-size: 48px; margin-bottom: 12px;">📅</div>
      <h3 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Bạn chưa có lịch khám nào</h3>
      <p style="color: var(--text-muted); margin-bottom: 20px;">Hãy đặt lịch khám để được các bác sĩ chuyên khoa chăm sóc sức khỏe tốt nhất.</p>
      <a href="/appointments/book" class="btn btn-primary">Đặt lịch ngay</a>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <% appointments.forEach(app => { %>
        <div class="card-box" style="padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 20px;">
          
          <div style="display: flex; align-items: center; gap: 18px;">
            <div class="upcoming-icon-box" style="width: 54px; height: 54px;">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>

            <div>
              <div style="display:flex; align-items:center; gap:10px; margin-bottom: 4px; flex-wrap:wrap;">
                <span style="font-weight: 800; font-size: 17px; color: #0f172a;">
                  <%= app.service_name || ('Khám ' + app.specialty_name) %>
                </span>
                <span class="booking-code-pill" style="font-size: 11.5px;">
                  <%= app.booking_code %>
                </span>
                <% if (app.is_bumped) { %>
                  <span style="font-size:11px; background:#fffbeb; color:#b45309; border:1px solid #fde68a; padding:2px 8px; border-radius:6px; font-weight:700;">
                    ⚠️ Đã nhường ca cấp cứu (Ưu tiên tiếp)
                  </span>
                <% } %>
              </div>

              <div style="font-size: 14px; color: var(--primary); font-weight: 600; margin-bottom: 6px;">
                <%= app.doctor_name %> &bull; <%= app.room_number %>
              </div>

              <div style="font-size: 13px; color: var(--text-muted); display: flex; gap: 14px;">
                <span>📅 <%= formatDate(app.appointment_date) %></span>
                <span>⏰ <%= app.start_time %> - <%= app.end_time %></span>
              </div>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 10px;">
            <%- getStatusBadge(app.status) %>
            <a href="/appointments/<%= app.booking_code %>" class="btn btn-outline btn-sm">
              Chi tiết hồ sơ &rarr;
            </a>
          </div>

        </div>
      <% }); %>
    </div>
  <% } %>
</div>
