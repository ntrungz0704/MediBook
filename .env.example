# ==========================================
# MediBook - Environment Variables Configuration
# ==========================================

# Port for the web server to listen on
PORT=3000

# Environment mode: development | production | test
NODE_ENV=development

# Session Secret Key
# REQUIRED in production mode!
# In production, replace with a strong, cryptographically secure random string (at least 32 characters)
SESSION_SECRET=replace_with_a_long_random_secret

# Database File Path (Optional, defaults to database/medibook.sqlite)
DATABASE_PATH=database/medibook.sqlite

# Admin khởi tạo (chỉ dùng khi CSDL trống và NODE_ENV=production; ở dev/test dữ liệu demo được nạp tự động)
# ADMIN_INITIAL_EMAIL=admin@medibook.local
# ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password_min_8_chars

# Giới hạn tần suất (tùy chọn)
# RATE_LIMIT_LOGIN_MAX=10     # số lần đăng nhập sai tối đa / 15 phút / (IP + email)
# RATE_LIMIT_SIGNUP_MAX=20    # số lần đăng ký / đặt lịch khách tối đa / giờ / IP

# Đặt khi chạy sau reverse proxy (nginx, ...) để cookie secure & req.ip hoạt động đúng
# TRUST_PROXY=true
