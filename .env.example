# ==========================================
# MediBook - Environment Variables Configuration
# ==========================================

# Port for the web server to listen on
PORT=3000

# Environment mode: development | production | test
NODE_ENV=development

# Session Secret Key
# REQUIRED in production mode!
# In production, replace with a strong, cryptographically secure random string (at least 32 characters)
SESSION_SECRET=replace_with_a_long_random_secret

# Database File Path (Optional, defaults to database/medibook.sqlite)
DATABASE_PATH=database/medibook.sqlite
