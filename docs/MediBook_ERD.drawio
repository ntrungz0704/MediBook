  <diagram id="erd-diagram" name="MediBook - ERD Diagram">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========================================== -->
        <!-- HÀNG 1: TÀI KHOẢN, HỒ SƠ & BẢO MẬT (y = 40) -->
        <!-- ========================================== -->

        <!-- 1. USERS -->
        <mxCell id="t_users" value="users&#xa;---------------------------------&#xa;+ id : int [PK]&#xa;  role : text [CHECK patient|receptionist|doctor|admin]&#xa;  name : text&#xa;  email : text [UK]&#xa;  password_hash : text&#xa;  phone : text&#xa;  status : text [CHECK active|locked]&#xa;  created_at : datetime" style="shape=table;startSize=26;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="220" height="175" as="geometry" />
        </mxCell>

        <!-- 2. PATIENTS -->
        <mxCell id="t_patients" value="patients&#xa;---------------------------------&#xa;+ id : int [PK]&#xa;# user_id : int [FK, UNIQUE, NULL nếu vãng lai]&#xa;  full_name : text&#xa;  phone : text&#xa;  dob : text&#xa;  gender : text&#xa;  blood_group : text&#xa;  health_insurance_no : text" style="shape=table;startSize=26;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
