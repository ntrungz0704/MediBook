        <!-- ========================================== -->

        <!-- 13. PAYMENTS -->
        <mxCell id="t_payments" value="payments&#xa;---------------------------------&#xa;+ id : int [PK]&#xa;# appointment_id : int [FK, UNIQUE (0..1)]&#xa;# patient_id : int [FK]&#xa;  service_fee : int [VNĐ]&#xa;  medicine_fee : int [VNĐ]&#xa;  amount : int [VNĐ]&#xa;  payment_method : text&#xa;  status : text [unpaid|paid|refunded]&#xa;  paid_at : datetime&#xa;# received_by : int [FK users.id]" style="shape=table;startSize=26;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
